---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';
import Popup from '../components/Popup.astro';
import { site, absolute, SITE_URL } from '../lib/content';

interface Props {
  page: any;
}
const { page } = Astro.props;
const seo = page.seo;
const canonical = SITE_URL + (page.old_path === '/' ? '/' : encodeURI(page.old_path));
const ogImage = absolute(seo.og?.image) ?? absolute(site.og_logo);
const GTM_ID = 'GTM-PV57PGLL';
const PIXEL_ID = '130381808053594';
const GA_ID = 'G-PF16ZQ5HVJ';
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    {seo.description && <meta name="description" content={seo.description} />}
    <meta name="robots" content={seo.robots ?? 'index, follow'} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={seo.og?.type ?? 'website'} />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content={seo.og?.site_name ?? 'Face2Face'} />
    <meta property="og:title" content={seo.og?.title ?? seo.title} />
    {(seo.og?.description ?? seo.description) && <meta property="og:description" content={seo.og?.description ?? seo.description} />}
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content="Face2Face – נגה מלסה: צילום, וידאו ועיצוב גרפי" />}
    <meta name="twitter:card" content={seo.twitter?.card ?? 'summary_large_image'} />
    <meta name="twitter:title" content={seo.twitter?.title ?? seo.title} />
    {(seo.twitter?.description ?? seo.description) && <meta name="twitter:description" content={seo.twitter?.description ?? seo.description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" href="/assets/media/icons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/media/icons/180_180_63ea95b0eb841.png" />
    <meta name="theme-color" content="#141414" />
    <meta name="google-site-verification" content="5Sw7hDf_lk-VEjnxIwE6X296VZb9XwRbKhzZoAyodig" />

    <!-- page-specific hints (e.g. the home page's LCP image preload) -->
    <slot name="head" />

    <!--
      All three Almoni DL weights the site uses. Without a preload the browser only discovers a
      font after the stylesheet is parsed, which delays first paint (measured: FCP 1.8s -> 1.0s
      together with the inlined CSS).
    -->
    <link rel="preload" href="/fonts/almoni-dl-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/almoni-dl-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/almoni-dl-900.woff2" as="font" type="font/woff2" crossorigin />

    <Schema />

    <!--
      Google Tag Manager + Meta Pixel.
      The dataLayer / fbq queues are created immediately (no network), so every event is recorded
      with its original order. Only the two library downloads (~230KB of third-party JS, which
      competed with the Hero image for bandwidth and cost ~2s of LCP on mobile) wait until the page
      has loaded and the browser is idle, or until the visitor first interacts.
    -->
    <script is:inline define:vars={{ GTM_ID, PIXEL_ID, GA_ID }}>
      (function (w, d) {
        // Consent: nothing third-party is downloaded or sent until the visitor accepts (banner at the bottom).
        function getConsent() {
          try { return localStorage.getItem('f2f-consent'); } catch (e) { return null; }
        }
        // Queues are created immediately (no network), so events keep their order once consent is given.
        w.dataLayer = w.dataLayer || [];
        w.gtag = function () { w.dataLayer.push(arguments); };
        w.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        w.gtag('js', new Date());
        w.gtag('config', GA_ID);
        if (!w.fbq) {
          var n = (w.fbq = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          });
          if (!w._fbq) w._fbq = n;
          n.push = n;
          n.loaded = !0;
          n.version = '2.0';
          n.queue = [];
        }
        w.fbq('init', PIXEL_ID);
        w.fbq('track', 'PageView');

        // Conversion events (GA4 + Meta). Silent unless the visitor accepted tracking.
        w.f2fTrack = function (name, params, fbName) {
          if (getConsent() !== 'granted') return;
          try { w.gtag('event', name, params || {}); } catch (e) {}
          try { if (fbName) w.fbq('track', fbName, params || {}); } catch (e) {}
        };

        var started = false;
        function add(src) {
          var s = d.createElement('script');
          s.async = true;
          s.src = src;
          d.head.appendChild(s);
        }
        function start() {
          if (started || getConsent() !== 'granted') return;
          started = true;
          add('https://www.googletagmanager.com/gtag/js?id=' + GA_ID);
          add('https://www.googletagmanager.com/gtm.js?id=' + GTM_ID);
          add('https://connect.facebook.net/en_US/fbevents.js');
        }
        // Called by the consent banner / footer link
        w.f2fSetConsent = function (v) {
          try { localStorage.setItem('f2f-consent', v); } catch (e) {}
          if (v === 'granted') start();
        };
        var interactions = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
        function onInteract() {
          interactions.forEach(function (e) {
            w.removeEventListener(e, onInteract);
          });
          start();
        }
        interactions.forEach(function (e) {
          w.addEventListener(e, onInteract, { passive: true });
        });
        function afterLoad() {
          if ('requestIdleCallback' in w) w.requestIdleCallback(start, { timeout: 3000 });
          else setTimeout(start, 1500);
        }
        if (d.readyState === 'complete') afterLoad();
        else w.addEventListener('load', afterLoad, { once: true });

        // Click conversions: WhatsApp, phone, email
        d.addEventListener('click', function (e) {
          var a = e.target && e.target.closest && e.target.closest('a[href]');
          if (!a) return;
          var h = a.getAttribute('href') || '';
          if (/^https?:\/\/(wa\.me|api\.whatsapp\.com)\//.test(h)) w.f2fTrack('whatsapp_click', { link_url: h }, 'Contact');
          else if (h.indexOf('tel:') === 0) w.f2fTrack('phone_click', { link_url: h }, 'Contact');
          else if (h.indexOf('mailto:') === 0) w.f2fTrack('email_click', { link_url: h }, 'Contact');
        });
      })(window, document);
    </script>
  </head>
  <body>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">דילוג לתוכן</a>
    <Header current={page.old_path} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <a
      class="wa-float"
      href={site.contact.whatsapp}
      target="_blank"
      rel="noopener"
      aria-label="שליחת הודעה ב-WhatsApp לנגה מלסה"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="52" height="52" aria-hidden="true" focusable="false"
        ><circle cx="16" cy="16" r="16" fill="#25D366"></circle><path
          fill="#fff"
          d="M23.4 8.6A10.3 10.3 0 0 0 7.2 21l-1.4 5.2 5.3-1.4a10.3 10.3 0 0 0 4.9 1.2 10.3 10.3 0 0 0 7.4-17.4zM16 24.3a8.5 8.5 0 0 1-4.4-1.2l-.3-.2-3.1.8.8-3.1-.2-.3a8.6 8.6 0 1 1 7.2 4zm4.7-6.4c-.3-.1-1.5-.8-1.8-.8-.2-.1-.4-.1-.6.1l-.8 1c-.2.2-.3.2-.6.1a7 7 0 0 1-3.5-3c-.3-.5.3-.4.8-1.4.1-.2 0-.3 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.2-.3-.2-.6-.4z"
        ></path></svg
      >
    </a>

    <div class="cookie" id="cookie" role="region" aria-label="הסכמה לעוגיות" hidden>
      <p>
        אנחנו משתמשים בעוגיות ובכלי מעקב (Google Analytics ו-Meta) כדי להבין איך משתמשים באתר ולמדוד פרסום. הם נטענים רק באישורך.
        <a href="/privacy">מדיניות פרטיות</a>
      </p>
      <div class="cookie__actions">
        <button class="btn" type="button" id="cookie-ok">מאשר/ת</button>
        <button class="btn btn--ghost" type="button" id="cookie-no">רק הכרחי</button>
      </div>
    </div>

    <Popup />

    <script>
      // Scroll progress bar + reveal-on-scroll
      const bar = document.getElementById('scroll-progress') as HTMLElement | null;
      if (bar) {
        let ticking = false;
        const upd = () => {
          const h = document.documentElement.scrollHeight - innerHeight;
          bar.style.transform = `scaleX(${h > 0 ? Math.min(scrollY / h, 1) : 0})`;
          ticking = false;
        };
        addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(upd); } }, { passive: true });
        upd();
      }
      const targets = document.querySelectorAll<HTMLElement>(
        'main .section-title, main .section-lead, .about__visual, .about__text > *, .contact .info__card, .contact .social-row, .contact .form-card, .counter, .slider-wrap, .tabs'
      );
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }), { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
        targets.forEach((el, i) => {
          el.classList.add('reveal');
          el.style.setProperty('--rd', `${(i % 4) * 0.07}s`);
          io.observe(el);
        });
      }
    </script>

    <script>
      const banner = document.getElementById('cookie')!;
      const w = window as any;
      let choice: string | null = null;
      try { choice = localStorage.getItem('f2f-consent'); } catch {}
      if (!choice) banner.hidden = false;
      const decide = (v: 'granted' | 'denied') => {
        w.f2fSetConsent?.(v);
        banner.hidden = true;
      };
      document.getElementById('cookie-ok')!.addEventListener('click', () => decide('granted'));
      document.getElementById('cookie-no')!.addEventListener('click', () => decide('denied'));
      // footer "הגדרות עוגיות" link reopens the banner
      document.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest?.('[data-cookie-settings]')) banner.hidden = false;
      });
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    inset-inline-start: 12px;
    top: -60px;
    background: var(--brand-ink);
    color: #fff;
    padding: 8px 16px;
    border-radius: 8px;
    z-index: 100;
  }
  .skip-link:focus {
    top: 12px;
  }
  .wa-float {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 60;
    width: 56px;
    height: 56px;
    line-height: 0;
    border-radius: 50%;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s, box-shadow 0.2s;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .wa-float:hover {
    transform: scale(1.08);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }
  .wa-float:active {
    transform: scale(0.95);
  }
  @media (max-width: 560px) {
    .wa-float {
      bottom: 16px;
      right: 16px;
      width: 52px;
      height: 52px;
    }
  }
  .cookie {
    position: fixed;
    inset-inline: 16px;
    bottom: 16px;
    z-index: 70;
    max-width: 640px;
    margin-inline: auto;
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    background: var(--dark);
    color: #fff;
    padding: 14px 18px;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    font-size: 0.95rem;
  }
  .cookie[hidden] {
    display: none;
  }
  .cookie p {
    margin: 0;
    line-height: 1.45;
  }
  .cookie p a { color: #fff; text-decoration: underline; }
  .cookie__actions { display: flex; gap: 10px; flex: none; }
  .cookie__actions .btn { min-height: 44px; white-space: nowrap; }
  @media (max-width: 560px) {
    .cookie {
      flex-direction: column;
      text-align: center;
      bottom: 84px;
    }
    .cookie__actions { width: 100%; }
    .cookie__actions .btn { flex: 1; justify-content: center; }
  }
</style>
