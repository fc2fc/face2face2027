---
// Every page of the old Site123 site, rendered at exactly the same URL.
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import HeroPreload from "../components/HeroPreload.astro";
import ParallaxGallery3D from "../components/ParallaxGallery3D.astro";
import Services from "../components/Services.astro";
import Gallery from "../components/Gallery.astro";
import About from "../components/About.astro";
import Clients from "../components/Clients.astro";
import Counters from "../components/Counters.astro";
import Contact from "../components/Contact.astro";
import Legal from "../components/Legal.astro";
import PortfolioItem from "../components/PortfolioItem.astro";
import { pages } from "../lib/content";

export function getStaticPaths() {
  return pages.map((page) => ({
    params: {
      path: page.old_path === "/" ? undefined : page.old_path.slice(1),
    },
    props: { page },
  }));
}

const { page } = Astro.props;
const SINGLE: Record<string, any> = {
  "/services": Services,
  "/portfolio": Gallery,
  "/about": About,
  "/clients": Clients,
  "/counters": Counters,
  "/contact": Contact,
};
const Single = SINGLE[page.old_path];
---

<Base page={page}>
  {page.type === "home" && <HeroPreload slot="head" />}
  {
    page.type === "home" && (
      <>
        <Hero />
        <Clients />
        <ParallaxGallery3D />
        <Services />
        <Gallery limit={12} />
        <Counters />
        <About />
        <Contact />
      </>
    )
  }
  {Single && <Single headingLevel="h1" />}
  {page.type === "legal" && <Legal page={page} />}
  {page.type === "portfolio-item" && <PortfolioItem page={page} />}
</Base>
