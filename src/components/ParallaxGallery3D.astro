---
// "הסיפורים שצילמנו" – גלריית parallax תלת-ממדית במסך מלא, צילום סטילס בלבד
import { Picture } from 'astro:assets';
import { site, asset } from '../lib/content';

const stillsCat = (site.portfolio as any[]).find((c) => c.category === 'צילום סטילס');
const all = ((stillsCat?.items || []) as any[]).filter((i) => i.src);
const byId = (id: string) => all.find((i) => i.src.includes(id));
// Curated wall: first 24 stills, with the award-ceremony stage shot swapped out, plus hand-picked event photos
const SWAP: Record<string, string> = { '696ac38eeac63': '688b84a344086' };
const EXTRA = ['688b84a982d97', '688b84aa9eff4', '688b8393f1d69', '688bed6403107', '688b8395959aa'];
// Per-photo crop focus where the default (center 20%) would cut out what matters
const FOCUS: Record<string, string> = { '688b8393f1d69': '22% 8%' };
const focusOf = (src: string) => Object.entries(FOCUS).find(([id]) => src.includes(id))?.[1];
const stills = [
  ...all.slice(0, 24).map((i) => {
    const k = Object.keys(SWAP).find((id) => i.src.includes(id));
    return (k && byId(SWAP[k])) || i;
  }),
  ...EXTRA.map(byId).filter(Boolean),
];
const cols = [0, 1, 2, 3].map((n) => stills.filter((_, i) => i % 4 === n));
const double = (arr: any[]) => [...arr, ...arr];
---

<section class="p3d" id="parallax-gallery" aria-label="גלריית צילום סטילס">
  <div class="p3d__sticky">
    <div class="p3d__grid" id="pGrid" aria-hidden="true">
      {cols.map((col, n) => (
        <div class="p3d__col" id={`col${n + 1}`}>
          {double(col).map((img: any) => (
            <div class="p3d__card">
              <Picture
                src={asset(img.src)}
                alt=""
                widths={[240, 400, 640]}
                sizes="(max-width: 600px) 160px, 37vw"
                formats={['avif']}
                fallbackFormat="webp"
                loading="lazy"
                decoding="async"
                style={focusOf(img.src) ? `object-position:${focusOf(img.src)}` : undefined}
              />
            </div>
          ))}
        </div>
      ))}
    </div>
    <div class="p3d__shade" id="pShade"></div>

    <div class="p3d__headline" id="pHeadline">
      <span class="p3d__badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z" /><circle cx="12" cy="13" r="4" /></svg>
        צילום סטילס
      </span>
      <h2>הסיפורים<br /><em>שצילמנו</em></h2>
      <p>מעל 4,950 פרויקטים – כל אחד עם נשמה</p>
      <a href="/עבודות" class="p3d__cta">לכל העבודות</a>
    </div>
  </div>
</section>

<style>
  .p3d {
    position: relative;
    height: 320vh;
    background: var(--bg);
  }
  .p3d__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--dark);
  }
  .p3d__grid {
    position: absolute;
    display: flex;
    gap: 16px;
    justify-content: center;
    align-items: flex-start;
    direction: ltr;
    width: 170%;
    left: -35%;
    height: 200%;
    top: -50%;
    transform-style: preserve-3d;
    transform: perspective(1000px) rotateY(-45deg) rotateX(25deg) rotateZ(15deg) translateZ(-800px);
    will-change: transform;
  }
  .p3d__col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 22%;
    min-width: 160px;
    flex-shrink: 0;
    will-change: transform;
  }
  .p3d__card {
    height: 270px;
    border-radius: 12px;
    overflow: hidden;
    flex-shrink: 0;
    background: #1a1a1a;
  }
  .p3d__card img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }

  /* Uniform darkening so the headline is always legible; fades out with the headline */
  .p3d__shade {
    position: absolute;
    inset: 0;
    background: rgba(12, 12, 12, 0.7);
    pointer-events: none;
  }
  .p3d__headline {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 0 20px;
    opacity: 0;
    transform: translateY(30px) scale(0.96);
    transition: opacity 0.9s cubic-bezier(.2,.7,.2,1), transform 0.9s cubic-bezier(.2,.7,.2,1);
  }
  .p3d__headline.is-in { opacity: var(--hop, 1); transform: none; }
  .p3d__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--brand);
    color: #fff;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 700;
    padding: 7px 18px;
    border-radius: 100px;
  }
  .p3d__headline h2 {
    font-size: clamp(2.6rem, 8vw, 5.5rem);
    font-weight: 900;
    line-height: 1.05;
    margin: 0;
    color: #fff;
  }
  .p3d__headline h2 em { color: var(--brand); font-style: normal; text-shadow: 0 0 40px rgba(0, 0, 0, 0.6); }
  .p3d__headline p { font-size: 1.1rem; color: #fff; margin: 0; }
  .p3d__cta {
    background: var(--brand);
    color: #fff;
    font-weight: 700;
    padding: 14px 32px;
    border-radius: 100px;
    text-decoration: none;
    margin-top: 8px;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    transition: background 0.2s, transform 0.2s;
  }
  .p3d__cta:hover { background: var(--brand-dark); transform: scale(1.05); }
  @media (max-width: 600px) {
    .p3d { height: 210vh; }
    .p3d__grid { gap: 8px; }
    .p3d__card { height: 190px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .p3d__headline { transition: none; }
  }
</style>

<script>
  const section = document.getElementById('parallax-gallery');
  const grid = document.getElementById('pGrid');
  const headline = document.getElementById('pHeadline');
  const shade = document.getElementById('pShade');
  const cols = [1, 2, 3, 4].map((n) => document.getElementById('col' + n));
  if (section && grid && headline && shade) {
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
    const ease = (t: number) => (t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t);
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Phones: a closer, flatter starting pose so the photo wall fills the screen from the first frame (desktop pose unchanged)
    const from = matchMedia('(max-width: 600px)').matches ? [-22, 16, 8, -260] : [-45, 25, 15, -800];

    let cur = 0;
    let raf = 0;
    const target = () => {
      const r = section.getBoundingClientRect();
      return clamp(-r.top / Math.max(1, section.offsetHeight - innerHeight), 0, 1);
    };
    const apply = (p: number) => {
      // headline stays for the first 12%, then fades; shade follows
      const f = clamp((p - 0.12) / 0.25, 0, 1);
      const op = 1 - f;
      headline.style.setProperty('--hop', String(op));
      if (headline.classList.contains('is-in')) headline.style.opacity = String(op);
      headline.style.pointerEvents = op < 0.2 ? 'none' : 'auto';
      shade.style.opacity = String(lerp(1, 0.05, ease(f)));
      const e = ease(clamp(p / 0.9, 0, 1));
      grid.style.transform = `perspective(1000px) rotateY(${lerp(from[0], -8, e)}deg) rotateX(${lerp(from[1], 4, e)}deg) rotateZ(${lerp(from[2], 2, e)}deg) translateZ(${lerp(from[3], 0, e)}px)`;
      const move = [[0, -40], [-40, 10], [0, -40], [-30, 20]];
      cols.forEach((c, i) => c && (c.style.transform = `translateY(${lerp(move[i][0], move[i][1], e)}%)`));
    };
    const tick = () => {
      const t = target();
      cur = still ? t : lerp(cur, t, 0.1);
      apply(cur);
      raf = Math.abs(cur - t) > 0.0005 ? requestAnimationFrame(tick) : 0;
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(tick); }, { passive: true });
    addEventListener('resize', () => { if (!raf) raf = requestAnimationFrame(tick); });
    apply(0);

    // Entrance: headline eases in once the section is on screen
    new IntersectionObserver((es, o) => {
      if (es.some((e) => e.isIntersecting)) { headline.classList.add('is-in'); o.disconnect(); }
    }, { threshold: 0.05 }).observe(section);
  }
</script>
