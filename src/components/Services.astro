---
import Icon from './Icon.astro';
import { site } from '../lib/content';

interface Props {
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const services = site.services as { category: string; title: string; text: string; icon: string }[];
const iconNames = ['camera', 'video-camera', 'pen-nib', 'megaphone'];
const numbers = ['01', '02', '03', '04'];
const accents = ['var(--brand)', 'var(--blue)', 'var(--yellow)', 'var(--brand)'];
---

<section class="section section--soft" id="services">
  <div class="container">
    <Heading class="section-title">מה אנחנו עושים</Heading>
    <p class="section-lead">צילום, וידאו, עיצוב ודיגיטל – הכל תחת קורת גג אחת, מותאם לשפת המותג שלכם.</p>
    <div class="bento">
      {
        services.map((s, i) => (
          <article class={`card card--${i + 1}`} style={`--accent:${accents[i % accents.length]}`}>
            <div class="card__glow" aria-hidden="true"></div>
            <span class="card__num" aria-hidden="true">{numbers[i]}</span>
            <div class="card__icon" aria-hidden="true">
              <Icon name={iconNames[i] ?? 'camera'} size={34} />
            </div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <a class="card__link" href="/work">
              לעבודות בתחום
              <Icon name="arrow-left" size={16} />
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 18px;
  }
  .card--1,
  .card--4 { grid-column: span 4; }
  .card--2,
  .card--3 { grid-column: span 2; }

  .card {
    --mx: 50%;
    --my: 0%;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 34px 30px 28px;
    border-radius: 22px;
    background: var(--surface);
    border: 1px solid var(--line);
    transition: transform 0.35s cubic-bezier(.2,.7,.2,1), border-color 0.3s, box-shadow 0.3s;
  }
  .card:hover {
    transform: translateY(-6px);
    border-color: var(--accent);
    box-shadow: 0 22px 50px rgba(0, 0, 0, 0.5);
  }
  /* Pointer-following spotlight */
  .card__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    transition: opacity 0.3s;
    background: radial-gradient(420px circle at var(--mx) var(--my), color-mix(in srgb, var(--accent) 26%, transparent), transparent 62%);
  }
  .card:hover .card__glow { opacity: 1; }

  .card__num {
    position: absolute;
    top: 10px;
    inset-inline-end: 22px;
    font-family: var(--font);
    font-weight: 900;
    font-size: 2.4rem;
    line-height: 1;
    /* solid white on the dark card: ~16:1 contrast (WCAG AA needs 4.5:1) */
    color: #fff;
    pointer-events: none;
  }
  .card__icon {
    width: 62px;
    height: 62px;
    border-radius: 18px;
    display: grid;
    place-items: center;
    margin-bottom: 14px;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .card__icon :global(svg) {
    display: block;
    width: 34px;
    height: 34px;
    color: var(--accent);
    transition: transform 0.35s cubic-bezier(.2,.7,.2,1);
  }
  .card:hover .card__icon :global(svg) { transform: scale(1.14) rotate(-6deg); }

  .card h3 {
    font-size: 1.5rem;
    margin: 0;
    color: #fff;
  }
  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.5;
    max-width: 62ch;
  }
  .card__link {
    margin-top: auto;
    padding-top: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    color: #fff;
    font-family: var(--font-ui);
    font-weight: 700;
    text-decoration: none;
    min-height: 44px;
  }
  .card__link svg { transition: transform 0.25s; color: var(--accent); }
  .card__link:hover svg,
  .card:hover .card__link svg { transform: translateX(-5px); }
  .card__link:hover { text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 860px) {
    .bento { grid-template-columns: repeat(2, 1fr); }
    .card--1, .card--4 { grid-column: span 2; }
    .card--2, .card--3 { grid-column: span 1; }
  }
  @media (max-width: 600px) {
    /* stays 2-up side-by-side instead of stacking to one card per row */
    .bento { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .card--1, .card--2, .card--3, .card--4 { grid-column: span 1; }
    .card { padding: 18px 14px 16px; border-radius: 16px; gap: 8px; }
    .card__num { font-size: 1.4rem; top: 8px; inset-inline-end: 14px; }
    .card__icon { width: 44px; height: 44px; border-radius: 13px; margin-bottom: 4px; }
    .card__icon :global(svg) { width: 22px; height: 22px; }
    .card h3 { font-size: 1.05rem; }
    .card p { font-size: 0.82rem; line-height: 1.45; }
    .card__link { font-size: 0.82rem; padding-top: 8px; min-height: 36px; }
  }
</style>

<script>
  // Pointer-following spotlight on each card (skipped for touch / reduced motion)
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && matchMedia('(hover: hover)').matches) {
    document.querySelectorAll<HTMLElement>('#services .card').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    });
  }
</script>
