---
import { site } from '../lib/content';

interface Props {
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const services = site.services as { category: string; title: string; text: string; icon: string }[];
---

<section class="section section--soft" id="services">
  <div class="container">
    <Heading class="section-title">שירותים</Heading>
    <p class="section-lead">צילום, וידאו, עיצוב ודיגיטל – הכל תחת קורת גג אחת, מותאם לשפת המותג שלכם.</p>
    <div class="grid">
      {
        services.map((s) => (
          <article class="card">
            <span class="icon" style={`--icon: url('${s.icon}')`} aria-hidden="true" />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  .card {
    background: #fff;
    border-radius: var(--radius);
    padding: 32px 26px;
    box-shadow: var(--shadow);
    transition: transform 0.25s;
  }
  .card:hover {
    transform: translateY(-4px);
  }
  .icon {
    display: block;
    width: 56px;
    height: 56px;
    margin-bottom: 18px;
    background: var(--brand);
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }
  h3 {
    font-size: 1.4rem;
  }
  p {
    margin: 0;
    color: var(--muted);
  }
</style>
