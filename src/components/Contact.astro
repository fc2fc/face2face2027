---
import Icon from './Icon.astro';
import { site } from '../lib/content';
import LeadForm from './LeadForm.astro';

interface Props {
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const c = site.contact;
const fields = [
  { type: 'text',     name: 'full_name', label: 'שם מלא',           required: true },
  { type: 'tel',      name: 'phone',     label: 'טלפון',             required: true },
  { type: 'email',    name: 'email',     label: 'כתובת הדואר האלקטרוני', required: true },
  { type: 'textarea', name: 'message',   label: 'הודעה',             required: false },
];
const regions = ['הדרום', 'השפלה', 'גוש דן', 'השרון', 'ירושלים', 'הצפון'];
---

<section class="section" id="contact">
  <div class="container">
    <Heading class="section-title">צרו קשר</Heading>
    <p class="section-lead">נשמח לשמוע עליכם ולתאם צילום שיראה את המיטב שלכם</p>

    <div class="grid">
      <a class="b b--wa" href={c.whatsapp} target="_blank" rel="noopener">
        <span class="b__ico">
          <Icon name="whatsapp-logo" size={26} />
        </span>
        <span class="b__t">
          <strong>דברו איתנו בוואטסאפ</strong>
          <span dir="ltr">{c.phone}</span>
        </span>
      </a>
      <a class="b b--tel" href={`tel:${c.phone.replace(/[^+\d]/g, '')}`}>
        <span class="b__ico b__ico--blue"><Icon name="phone-call" size={26} /></span>
        <span class="b__t">
          <strong>התקשרו אלינו</strong>
          <span dir="ltr">{c.phone}</span>
        </span>
      </a>

      <div class="b b--loc">
        <div class="radar" aria-hidden="true">
          <span class="pulse"></span><span class="pulse p2"></span>
          <span class="pin">
            <Icon name="map-pin" size={30} />
          </span>
        </div>
        <div class="b__body">
          <span class="b__label">מיקום</span>
          <strong class="city">קרית גת</strong>
          <span class="sub">פעילים ברחבי הארץ</span>
          <ul class="regions">
            {regions.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>

      <a class="b b--mail" href={`mailto:${c.email}`}>
        <span class="b__ico b__ico--blue">
          <Icon name="envelope-simple" size={24} />
        </span>
        <span class="b__t"><strong>אימייל</strong><span>{c.email}</span></span>
      </a>

      <div class="b b--hours">
        <span class="b__ico b__ico--yellow">
          <Icon name="clock" size={24} />
        </span>
        <span class="b__t">
          <strong>שעות פעילות</strong>
          {c.hours.map((h: { days: string; hours: string }) => (
            <span>{h.days}: <span dir="ltr">{h.hours}</span></span>
          ))}
        </span>
      </div>

      <div class="b b--social">
        <a href="https://www.facebook.com/Face2FaceNM" target="_blank" rel="noopener" aria-label="Facebook" class="soc">
          <Icon name="facebook-logo" size={22} />
        </a>
        <a href="https://www.instagram.com/face2face.il/" target="_blank" rel="noopener" aria-label="Instagram" class="soc">
          <Icon name="instagram-logo" size={22} />
        </a>
        <a href="https://www.youtube.com/channel/UCQiw4Yb63IUjjAmjmKkAG0Q" target="_blank" rel="noopener" aria-label="YouTube" class="soc">
          <Icon name="youtube-logo" size={22} />
        </a>
      </div>

      <div class="b b--form">
        <h3>השאירו פרטים ונחזור אליכם</h3>
        <LeadForm fields={fields} submitLabel="שליחה" formName="contact" />
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    margin-top: 2rem;
  }
  .b {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px;
    border-radius: 22px;
    background: var(--surface);
    border: 1px solid var(--line);
    text-decoration: none;
    color: #fff;
    transition: transform 0.3s cubic-bezier(.2,.7,.2,1), border-color 0.25s, box-shadow 0.25s;
  }
  a.b:hover { transform: translateY(-4px); border-color: #555; box-shadow: 0 16px 34px rgba(0, 0, 0, 0.5); }
  .b__ico {
    width: 52px; height: 52px; border-radius: 15px; flex: none;
    display: grid; place-items: center;
    background: var(--brand); color: #fff;
  }
  .b__ico--blue { background: var(--blue); color: #0e0e0e; }
  .b__ico--yellow { background: var(--yellow); color: #0e0e0e; }
  .b__t { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .b__t strong { font-size: 1.05rem; color: #fff; }
  .b__t span { color: var(--muted); font-size: 0.95rem; overflow-wrap: anywhere; }

  .b--tel { grid-column: span 3; }
  .b--wa { grid-column: span 3; background: var(--brand); border-color: var(--brand); }
  .b--wa .b__ico { background: #fff; color: var(--brand); }
  .b--wa .b__t strong { font-size: 1.3rem; }
  .b--wa .b__t span { color: #fff; font-weight: 700; font-size: 1.1rem; }
  a.b--wa:hover { border-color: #fff; }

  .b--loc { grid-column: span 3; grid-row: span 2; gap: 22px; }
  .radar { position: relative; width: 120px; height: 120px; flex: none; display: grid; place-items: center; }
  .radar::before {
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    background:
      radial-gradient(circle, transparent 0 28%, rgba(255,255,255,.12) 28.5% 29.5%, transparent 30% 52%, rgba(255,255,255,.1) 52.5% 53.5%, transparent 54% 76%, rgba(255,255,255,.08) 76.5% 77.5%, transparent 78%);
  }
  .pulse { position: absolute; width: 56px; height: 56px; border-radius: 50%; background: var(--brand); opacity: 0.4; animation: ping 2.8s ease-out infinite; }
  .p2 { animation-delay: 1.4s; }
  .pin { position: relative; color: #fff; filter: drop-shadow(0 0 10px rgba(208, 0, 127, 0.7)); }
  @keyframes ping { from { transform: scale(0.6); opacity: .5; } to { transform: scale(2.1); opacity: 0; } }
  .b__body { display: flex; flex-direction: column; gap: 6px; }
  .b__label { font-family: var(--font-ui); font-size: .85rem; color: var(--muted); }
  .city { font-size: 2.6rem; font-weight: 900; line-height: 1; color: #fff; }
  .sub { color: #fff; font-weight: 700; }
  .regions { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .regions li { font-size: .8rem; font-family: var(--font-ui); font-weight: 700; padding: 4px 11px; border-radius: 100px; background: #101010; border: 1px solid var(--line); color: #fff; }
  .regions li:first-child { background: var(--brand); border-color: var(--brand); }

  .b--mail, .b--hours { grid-column: span 3; align-items: flex-start; }
  .b--social { grid-column: span 3; justify-content: center; gap: 12px; }
  .soc {
    width: 52px; height: 52px; border-radius: 15px; display: grid; place-items: center;
    background: var(--surface-2); border: 1px solid var(--line); color: #fff;
    transition: background .2s, transform .2s;
  }
  .soc:hover { background: var(--brand); border-color: var(--brand); transform: translateY(-3px); }

  .b--form { grid-column: 1 / -1; flex-direction: column; align-items: stretch; padding: 32px; gap: 18px; }
  .b--form h3 { margin: 0; font-size: 1.5rem; color: #fff; }

  @media (max-width: 860px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    .b--wa, .b--tel, .b--loc, .b--form { grid-column: 1 / -1; }
    .b--loc { grid-row: auto; }
    .b--mail, .b--hours, .b--social { grid-column: span 2; }
  }
  @media (max-width: 520px) {
    .b { padding: 18px; border-radius: 18px; }
    .b--loc { flex-direction: row; align-items: flex-start; gap: 14px; }
    .radar { width: 76px; height: 76px; }
    .pulse { width: 40px; height: 40px; }
    .b--loc .b__body { flex: 1; min-width: 0; }
    .city { font-size: 2.2rem; }
    .b--form { padding: 22px 16px; }
    .soc { width: 56px; height: 56px; }
  }
  @media (prefers-reduced-motion: reduce) { .pulse { animation: none; } }
</style>
