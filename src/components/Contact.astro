---
import { site } from '../lib/content';
import LeadForm from './LeadForm.astro';

interface Props {
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const c = site.contact;
const fields = [
  { type: 'text',     name: 'full_name', label: 'שם מלא',           required: true },
  { type: 'tel',      name: 'phone',     label: 'טלפון',             required: true },
  { type: 'email',    name: 'email',     label: 'כתובת הדואר האלקטרוני', required: true },
  { type: 'textarea', name: 'message',   label: 'הודעה',             required: false },
];
---

<section class="section" id="contact">
  <div class="container">
    <Heading class="section-title">צרו קשר</Heading>
    <p class="section-lead">נשמח לשמוע עליכם ולתאם צילום שיראה את המיטב שלכם</p>
    <div class="contact">
      <div class="info">
        <div class="info__card">
          <div class="info__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 014.4 11.82 19.79 19.79 0 011.34 3.18 2 2 0 013.33 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L7.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          </div>
          <div>
            <strong>טלפון / WhatsApp</strong>
            <a href={c.whatsapp} target="_blank" rel="noopener" dir="ltr">{c.phone}</a>
          </div>
        </div>
        <div class="info__card">
          <div class="info__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div>
            <strong>אימייל</strong>
            <a href={`mailto:${c.email}`}>{c.email}</a>
          </div>
        </div>
        <div class="info__card">
          <div class="info__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div>
            <strong>שעות פעילות</strong>
            {c.hours.map((h: { days: string; hours: string }) => (
              <span>{h.days}: <span dir="ltr">{h.hours}</span></span>
            ))}
          </div>
        </div>
        <div class="info__card">
          <div class="info__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <strong>מיקום</strong>
            <span>תל אביב-יפו, גוש דן</span>
            <span>פעיל ברחבי הארץ</span>
          </div>
        </div>
        <div class="social-row">
          <a href="https://www.facebook.com/Face2FaceNM" target="_blank" rel="noopener" aria-label="Facebook" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
          </a>
          <a href="https://www.instagram.com/face2face.il/" target="_blank" rel="noopener" aria-label="Instagram" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/></svg>
          </a>
          <a href="https://www.youtube.com/channel/UCQiw4Yb63IUjjAmjmKkAG0Q" target="_blank" rel="noopener" aria-label="YouTube" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 00-1.95 1.96A29 29 0 001 12a29 29 0 00.46 5.58A2.78 2.78 0 003.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.4a2.78 2.78 0 001.95-1.95A29 29 0 0023 12a29 29 0 00-.46-5.58z"/><polygon fill="currentColor" stroke="none" points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
          </a>
        </div>
      </div>
      <div class="form-card">
        <LeadForm fields={fields} submitLabel="שליחה" formName="contact" />
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 48px;
    align-items: start;
  }
  .info__card {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 18px 20px;
    background: var(--bg-soft);
    border-radius: 14px;
    margin-bottom: 12px;
    border: 1px solid var(--line);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .info__card:hover {
    border-color: var(--brand);
    box-shadow: 0 4px 16px rgba(225,0,133,0.08);
  }
  .info__icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--brand);
    color: #fff;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .info__card div:last-child {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .info__card strong {
    color: var(--brand);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
  }
  .info__card a, .info__card span {
    font-weight: 600;
    text-decoration: none;
    font-size: 0.97rem;
    color: var(--ink);
  }
  .info__card a:hover { color: var(--brand); text-decoration: underline; }
  .social-row {
    display: flex;
    gap: 10px;
    margin-top: 16px;
  }
  .social-link {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    color: var(--muted);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .social-link:hover {
    background: var(--brand);
    color: #fff;
    border-color: var(--brand);
  }
  .form-card {
    background: #fff;
    padding: 36px;
    border-radius: 20px;
    box-shadow: 0 8px 40px rgba(15,13,22,0.08);
    border: 1px solid var(--line);
  }
  @media (max-width: 800px) {
    .contact { grid-template-columns: 1fr; gap: 28px; }
    .form-card { padding: 24px; }
  }
</style>
