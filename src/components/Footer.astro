---
import { Image } from 'astro:assets';
import { site } from '../lib/content';
import logo from '../assets/media/brand/logo-light@2x.webp';

const links = site.footer.links as { label: string; old_url: string }[];
const main = links.filter((l) => !['/terms', '/privacy', '/accessibility'].includes(l.old_url));
const legal = links.filter((l) => ['/terms', '/privacy', '/accessibility'].includes(l.old_url));
const social = [
  { href: 'https://www.facebook.com/Face2FaceNM', label: 'Facebook', icon: '<path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>' },
  { href: 'https://www.instagram.com/face2face.il/', label: 'Instagram', icon: '<rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>' },
  { href: 'https://www.youtube.com/channel/UCQiw4Yb63IUjjAmjmKkAG0Q', label: 'YouTube', icon: '<path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 00-1.95 1.96A29 29 0 001 12a29 29 0 00.46 5.58A2.78 2.78 0 003.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.4a2.78 2.78 0 001.95-1.95A29 29 0 0023 12a29 29 0 00-.46-5.58z" fill="none" stroke="currentColor" stroke-width="2"/><polygon fill="currentColor" points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/>' },
];
---

<footer class="footer">
  <div class="footer__wave" aria-hidden="true">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,30 C360,60 1080,0 1440,30 L1440,60 L0,60 Z" fill="var(--dark)"/>
    </svg>
  </div>

  <div class="footer__body">
    <div class="container footer__grid">
      <!-- עמודה ראשית -->
      <div class="footer__brand">
        <Image src={logo} alt="Face2Face" width={160} densities={[1, 2]} class="footer__logo" loading="lazy" />
        <p class="footer__tag">
          <strong>נגה מלסה</strong> – צלם ומעצב גרפי, מייסד Face2Face.<br/>
          צילום, וידאו ועיצוב גרפי לעסקים, לאנשי ציבור ולפרטיים.
        </p>
        <div class="footer__social">
          {social.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="social-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" set:html={s.icon} />
            </a>
          ))}
        </div>
      </div>

      <!-- ניווט -->
      <div>
        <h3 class="footer__heading">דפים</h3>
        <nav aria-label="ניווט תחתון">
          <ul class="footer__links">
            {main.map((l) => (
              <li>
                <a href={l.old_url}>
                  <span class="footer__link-dot" aria-hidden="true"></span>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- צרו קשר -->
      <div>
        <h3 class="footer__heading">צרו קשר</h3>
        <ul class="footer__contact">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 014.4 11.82 19.79 19.79 0 011.34 3.18 2 2 0 013.33 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L7.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            <a href={site.contact.whatsapp} target="_blank" rel="noopener" dir="ltr">{site.contact.phone}</a>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </li>
          {site.contact.hours.map((h: { days: string; hours: string }) => (
            <li class="hours">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span>{h.days}: <span dir="ltr">{h.hours}</span></span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <span>© {new Date().getFullYear()} Face2Face – כל הזכויות שמורות</span>
      <ul class="footer__legal">
        {legal.map((l) => <li><a href={l.old_url}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--dark);
    color: rgba(240,240,240,0.9);
    font-size: 0.94rem;
  }
  .footer__wave {
    line-height: 0;
    margin-bottom: -1px;
  }
  .footer__wave svg {
    width: 100%;
    height: 60px;
    display: block;
  }
  .footer__body {
    padding: 48px 0 40px;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr;
    gap: 40px;
  }
  /* Logo */
  .footer__logo {
    width: 160px;
    display: block;
    margin-bottom: 14px;
  }
  .footer__tag {
    margin: 0 0 20px;
    line-height: 1.7;
    max-width: 320px;
    font-size: 0.9rem;
  }
  .footer__tag strong { color: #fff; }

  /* Social */
  .footer__social {
    display: flex;
    gap: 8px;
  }
  .social-btn {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    display: grid;
    place-items: center;
    color: rgba(225,225,225,0.82);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .social-btn svg { fill: currentColor; }
  .social-btn:hover {
    background: var(--brand);
    color: #fff;
    border-color: var(--brand);
  }

  /* Headings */
  .footer__heading {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #fff;
    margin: 0 0 16px;
  }

  /* Nav links */
  .footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .footer__links a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 0;
    color: rgba(235,235,235,0.88);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer__links a:hover { color: #fff; }
  .footer__link-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--brand);
    flex-shrink: 0;
    opacity: 0.6;
    transition: opacity 0.15s;
  }
  .footer__links a:hover .footer__link-dot { opacity: 1; }

  /* Contact */
  .footer__contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer__contact li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgba(235,235,235,0.88);
  }
  .footer__contact li svg { flex-shrink: 0; color: var(--brand); }
  .footer__contact a {
    color: rgba(235,235,235,0.88);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer__contact a:hover { color: #fff; }
  .footer__contact .hours { font-size: 0.88rem; }

  /* Bottom */
  .footer__bottom {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 16px 0;
    font-size: 0.83rem;
    color: rgba(225,225,225,0.78);
  }
  .footer__bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .footer__legal {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 16px;
  }
  .footer__legal a {
    color: rgba(225,225,225,0.78);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer__legal a:hover { color: rgba(217,214,226,0.9); }

  @media (max-width: 760px) {
    .footer__grid { grid-template-columns: 1fr 1fr; gap: 28px 20px; }
    .footer__brand { grid-column: 1 / -1; }
    .footer__bottom-inner { flex-direction: column; align-items: flex-start; gap: 12px; }
    .footer__legal { flex-wrap: wrap; gap: 10px; }
  }
  @media (max-width: 480px) {
    .footer__grid { grid-template-columns: 1fr; gap: 24px; }
    .footer__social a {
      width: 44px;
      height: 44px;
    }
  }
</style>
