---
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import { site } from '../lib/content';
import logo from '../assets/media/brand/logo-light@2x.webp';

const links = site.footer.links as { label: string; old_url: string }[];
const main = links.filter((l) => !['/terms', '/privacy', '/accessibility'].includes(l.old_url));
const legal = links.filter((l) => ['/terms', '/privacy', '/accessibility'].includes(l.old_url));
const social = [
  { href: 'https://www.facebook.com/Face2FaceNM', label: 'Facebook', icon: 'facebook-logo' },
  { href: 'https://www.instagram.com/face2face.il/', label: 'Instagram', icon: 'instagram-logo' },
  { href: 'https://www.youtube.com/channel/UCQiw4Yb63IUjjAmjmKkAG0Q', label: 'YouTube', icon: 'youtube-logo' },
];
---

<footer class="footer">
  <!-- Big call-to-action (stays in normal flow, slides over the rest) -->
  <div class="footer__top"><div class="container">
    <div class="cta">
      <div class="cta__glow" aria-hidden="true"></div>
      <div class="cta__text">
        <span class="cta__eyebrow">בואו נצלם משהו מדהים</span>
        <h2 class="cta__title">יש לכם רעיון?<br /><em>נהפוך אותו לתמונה.</em></h2>
      </div>
      <div class="cta__actions">
        <a class="cta__btn cta__btn--solid" href={site.contact.whatsapp} target="_blank" rel="noopener">
          <Icon name="whatsapp-logo" size={22} />
          דברו איתנו בוואטסאפ
        </a>
        <a class="cta__btn cta__btn--line" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </div>
    </div>
  </div></div>

  <div class="footer__rest">
  <div class="footer__body">
    <div class="container footer__grid">
      <div class="footer__brand">
        <Image src={logo} alt="Face2Face" width={170} densities={[1, 2]} class="footer__logo" loading="lazy" />
        <p class="footer__tag">
          <strong>נגה מלסה</strong> – צלם ומעצב גרפי, מייסד Face2Face.<br />
          צילום, וידאו ועיצוב גרפי לעסקים, לאנשי ציבור ולפרטיים.
        </p>
        <div class="footer__social">
          {social.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="social-btn">
              <Icon name={s.icon} size={22} />
            </a>
          ))}
        </div>
      </div>

      <div>
        <h3 class="footer__heading">דפים</h3>
        <nav aria-label="ניווט תחתון">
          <ul class="footer__links">
            {main.map((l) => (
              <li>
                <a href={l.old_url}><span>{l.label}</span></a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <div>
        <h3 class="footer__heading">צרו קשר</h3>
        <ul class="footer__contact">
          <li>
            <Icon name="phone-call" size={16} />
            <a href={`tel:${site.contact.phone.replace(/[^+\d]/g, '')}`} dir="ltr">{site.contact.phone}</a>
          </li>
          <li>
            <Icon name="envelope-simple" size={16} />
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </li>
          {site.contact.hours.map((h: { days: string; hours: string }) => (
            <li class="hours">
              <Icon name="clock" size={16} />
              <span>{h.days}: <span dir="ltr">{h.hours}</span></span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Giant wordmark -->
  <div class="wordmark" aria-hidden="true"><span>FACE2FACE</span></div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <span>© {new Date().getFullYear()} Face2Face – כל הזכויות שמורות</span>
      <ul class="footer__legal">
        {legal.map((l) => <li><a href={l.old_url}>{l.label}</a></li>)}
        <li><button type="button" class="footer__cookie" data-cookie-settings>הגדרות עוגיות</button></li>
      </ul>
      <button type="button" class="to-top" aria-label="חזרה לראש העמוד" onclick="window.scrollTo({top:0,behavior:'smooth'})">
        <Icon name="arrow-up" size={18} />
      </button>
    </div>
  </div>
  </div>
</footer>

<script>
  const footerEl = document.querySelector<HTMLElement>('footer.footer .footer__rest');
  const cta = document.querySelector<HTMLElement>('.footer .cta');
  // The curtain reveal is pure CSS (position: sticky), so nothing moves when the script runs (no CLS).
  // Safety net only: on an unusually short desktop window the footer would be cut off, so fall back to the flat footer.
  if (footerEl) {
    const guard = () => document.documentElement.classList.toggle('footer-flat', footerEl.offsetHeight > innerHeight * 0.96);
    addEventListener('resize', guard, { passive: true });
    guard();
  }
  if (cta && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('is-in'); io.disconnect(); }
    }), { threshold: 0.2 });
    io.observe(cta);
  } else cta?.classList.add('is-in');
  // pointer spotlight on the CTA card
  if (cta && matchMedia('(hover: hover)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    cta.addEventListener('pointermove', (e) => {
      const r = cta.getBoundingClientRect();
      cta.style.setProperty('--mx', `${e.clientX - r.left}px`);
      cta.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  }
</script>

<style>
  @font-face {
    font-family: 'BrandFont';
    src: url('/fonts/brandfont-heavy-italic.woff2') format('woff2');
    font-weight: 900;
    font-style: italic;
    font-display: swap;
  }
  .footer {
    --fb: var(--blue);
    position: relative;
    color: rgba(240, 240, 240, 0.9);
    font-size: 0.94rem;
  }
  .footer__top { position: relative; z-index: 2; background: #0a0a0a; padding-top: clamp(32px, 4vw, 56px); }
  .footer__rest { position: relative; overflow: hidden; background: #0a0a0a; }
  .footer__rest::before {
    content: '';
    position: absolute;
    inset: auto -10% 0 -10%;
    height: 60%;
    background: radial-gradient(60% 80% at 50% 100%, color-mix(in srgb, var(--fb) 22%, transparent), transparent 70%);
    pointer-events: none;
  }

  /* ── CTA card ── */
  .cta {
    --mx: 50%;
    --my: 0%;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: clamp(28px, 5vw, 56px);
    border-radius: 28px;
    border: 1px solid color-mix(in srgb, var(--fb) 40%, transparent);
    background: linear-gradient(135deg, #0d1b24, #0a0a0a 60%);
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s cubic-bezier(.2,.7,.2,1), transform 0.8s cubic-bezier(.2,.7,.2,1);
  }
  .cta.is-in { opacity: 1; transform: none; }
  .cta__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(520px circle at var(--mx) var(--my), color-mix(in srgb, var(--fb) 28%, transparent), transparent 62%);
    transition: opacity 0.3s;
  }
  .cta__eyebrow {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fb) 16%, transparent);
    color: var(--fb);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.85rem;
    margin-bottom: 14px;
  }
  .cta__title {
    margin: 0;
    color: #fff;
    font-size: clamp(1.9rem, 4.6vw, 3.4rem);
    line-height: 1.1;
  }
  .cta__title em {
    font-style: normal;
    color: var(--fb);
  }
  .cta__actions { display: flex; flex-direction: column; gap: 12px; align-items: stretch; flex: none; }
  .cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 1.6em;
    border-radius: 999px;
    font-family: var(--font-ui);
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.25s, background 0.25s, box-shadow 0.25s;
  }
  .cta__btn--solid { background: var(--fb); color: #00131c; box-shadow: 0 10px 30px color-mix(in srgb, var(--fb) 35%, transparent); }
  .cta__btn--solid:hover { transform: translateY(-3px); box-shadow: 0 16px 40px color-mix(in srgb, var(--fb) 50%, transparent); }
  .cta__btn--line { color: #fff; border: 1px solid rgba(255,255,255,0.25); font-size: 0.92rem; }
  .cta__btn--line:hover { border-color: var(--fb); color: var(--fb); }

  .footer__body { position: relative; padding: clamp(32px, 4vw, 44px) 0 12px; margin-top: clamp(28px, 4vw, 44px); border-top: 1px solid rgba(255, 255, 255, 0.1); }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr;
    gap: clamp(32px, 5vw, 72px);
  }
  .footer__logo { width: 170px; display: block; margin-bottom: 16px; }
  .footer__tag { margin: 0 0 22px; line-height: 1.45; max-width: 340px; font-size: 0.92rem; color: rgba(235,235,235,0.85); }
  .footer__tag strong { color: #fff; }

  .footer__social { display: flex; gap: 10px; }
  .social-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    display: grid;
    place-items: center;
    color: rgba(235,235,235,0.9);
    transition: all 0.3s ease;
  }
  .social-btn:hover, .social-btn:focus-visible {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border-color: rgba(4, 168, 241, 0.8);
    box-shadow: 0 0 16px rgba(4, 168, 241, 0.45), 0 0 28px rgba(208, 0, 127, 0.35);
    transform: translateY(-4px);
    outline: none;
  }

  .footer__heading {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--fb);
    margin: 0 0 18px;
  }

  .footer__links { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .footer__links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 6px 0;
    color: rgba(240,240,240,0.9);
    text-decoration: none;
    transition: color 0.2s, transform 0.25s;
  }
  .footer__links a::before {
    content: '';
    width: 0;
    height: 2px;
    margin-inline-end: 0;
    background: var(--fb);
    border-radius: 2px;
    transition: width 0.25s, margin 0.25s;
  }
  .footer__links a:hover { color: #fff; }
  .footer__links a:hover::before { width: 16px; margin-inline-end: 10px; }

  .footer__contact { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .footer__contact li { display: flex; align-items: center; gap: 12px; color: rgba(240,240,240,0.9); }
  .footer__contact li svg { flex-shrink: 0; color: var(--fb); }
  .footer__contact a { color: rgba(240,240,240,0.9); text-decoration: none; transition: color 0.2s; }
  .footer__contact a:hover { color: var(--fb); }
  .footer__contact .hours { font-size: 0.88rem; }

  /* ── Giant wordmark: full width, BrandFont only, soft pink → blue gradient ── */
  .wordmark {
    position: relative;
    container-type: inline-size;
    overflow: hidden;
    line-height: 1;
    text-align: center;
    direction: ltr;
    user-select: none;
    padding: 8px 0 0;
  }
  .wordmark span {
    display: block;
    font-family: 'BrandFont', sans-serif;
    font-weight: 900;
    font-style: italic;
    font-size: 18.4cqw; /* 'FACE2FACE' is 5.33em wide in this font -> fills the width */
    line-height: 0.95;
    white-space: nowrap;
    background: linear-gradient(90deg, #d0007f, #04a8f1);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    opacity: 0.4;
    padding-inline: 1cqw;
  }

  .footer__bottom {
    position: relative;
    border-top: 1px solid rgba(255,255,255,0.1);
    padding: 16px 0;
    font-size: 0.83rem;
    color: rgba(235,235,235,0.82);
    background: #0a0a0a;
  }
  .footer__bottom-inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
  .footer__legal { list-style: none; margin: 0; padding: 0; display: flex; gap: 18px; }
  .footer__legal a { color: rgba(235,235,235,0.82); text-decoration: none; transition: color 0.2s; }
  .footer__cookie { background: none; border: 0; padding: 0; font: inherit; color: rgba(235,235,235,0.82); cursor: pointer; transition: color 0.2s; }
  .footer__cookie:hover { color: var(--fb); }
  .footer__legal a:hover { color: var(--fb); }
  .to-top {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--fb) 60%, transparent);
    background: transparent;
    color: var(--fb);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background 0.25s, color 0.25s, transform 0.25s;
  }
  .to-top:hover { background: var(--fb); color: #00131c; transform: translateY(-4px); }

  @media (max-width: 860px) {
    .cta { flex-direction: column; align-items: flex-start; }
    .cta__actions { width: 100%; }
  }
  @media (max-width: 760px) {
    .footer__grid { grid-template-columns: 1fr 1fr; gap: 28px 20px; }
    .footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .footer__grid { grid-template-columns: 1fr; gap: 28px; }
    .footer__bottom-inner { flex-direction: column; align-items: flex-start; }
    .footer__legal { flex-wrap: wrap; gap: 10px 16px; }
    .footer__links { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 16px; }
    .footer__bottom-inner { padding-bottom: 76px; }
    .to-top { align-self: flex-end; }
  }
  /* Footer reveal ("curtain"), pure CSS: the footer's lower part is sticky to the viewport bottom behind the opaque <main>.
     Nothing changes position after load, so it causes no layout shift. Only on roomy desktop windows. */
  @media (min-width: 1100px) and (min-height: 760px) {
    :global(html:not(.footer-flat)) :global(main#main) { position: relative; z-index: 2; background: var(--bg); }
    :global(html:not(.footer-flat)) .footer { display: contents; }
    :global(html:not(.footer-flat)) .footer__rest { position: sticky; bottom: 0; z-index: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta { opacity: 1; transform: none; transition: none; }
  }
</style>
