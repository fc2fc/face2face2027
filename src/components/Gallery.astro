---
import { site, size, thumb } from '../lib/content';

interface Props {
  limit?: number;
  pageSize?: number;
  headingLevel?: 'h1' | 'h2';
}
const { limit, headingLevel = 'h2', pageSize = 24 } = Astro.props;
const paged = !limit;
const Heading = headingLevel;
const categories = site.portfolio as { category: string; items: any[] }[];

// Build per-category parallax images (stills → face focus, video→ skip, design→ face focus)
function getCatImages(cat: { category: string; items: any[] }, max = 16) {
  return cat.items
    .filter((item: any) => item.src)           // stills/design only (videos have thumbnail)
    .map((item: any) => ({ src: thumb(item.src), alt: item.alt || item.title || cat.category }))
    .slice(0, max);
}
---

<section class="section" id="works">
  <div class="container">
    <Heading class="section-title">עבודות</Heading>
    <p class="section-lead">מבחר מהעבודות שלנו – לחצו על כל תמונה לצפייה מורחבת</p>
    <div class="tabs" role="tablist" aria-label="קטגוריות עבודות">
      {
        categories.map((c, i) => (
          <button type="button" role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'}>
            {c.category}
            <span class="tab__count">{c.items.length}</span>
          </button>
        ))
      }
    </div>

    {
      categories.map((c, i) => {
        const catImages = getCatImages(c);
        const hasParallax = catImages.length >= 4;
        // Split into 4 columns
        const cols: typeof catImages[] = [[], [], [], []];
        catImages.forEach((img, idx) => cols[idx % 4].push(img));
        // Double each column for infinite scroll feel
        const dcols = cols.map(col => [...col, ...col]);

        return (
          <div role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} hidden={i !== 0}>

            {/* 3D Parallax mini-gallery per category */}
            {hasParallax && (
              <div class="cat-parallax" data-cat-parallax={i} aria-hidden="true">
                <div class="cat-parallax__banner">
                  <div class="cat-parallax__grid">
                    {dcols.map((col, ci) => (
                      <div class="cat-parallax__col">
                        {col.map((img, ii) => (
                          <div class="cat-parallax__item">
                            <img
                              src={img.src}
                              alt={img.alt}
                              loading="lazy"
                              decoding="async"
                              style={`object-position: ${ci === 0 || ci === 2 ? 'center top' : 'center 20%'};`}
                            />
                          </div>
                        ))}
                      </div>
                    ))}
                  </div>
                  <div class="cat-parallax__overlay">
                    <span class="cat-parallax__label">{c.category}</span>
                    <span class="cat-parallax__count">{c.items.length} עבודות</span>
                  </div>
                </div>
              </div>
            )}

            {/* Grid of tiles */}
            <div class="grid">
              {(limit ? c.items.slice(0, limit) : c.items).map((item, n) =>
                item.type === 'video' ? (
                  <a class:list={['tile tile--video', paged && n >= pageSize && 'is-more']}
                    href={item.old_item_page ?? item.url}
                    data-youtube={item.youtube_id}
                    data-title={item.title}
                    data-n={n}>
                    <img src={item.thumbnail} alt={item.title ?? 'סרטון'} loading={n < 6 ? 'eager' : 'lazy'} {...size(item.thumbnail)} />
                    <span class="play" aria-hidden="true" />
                    {item.title && <span class="caption">{item.title}</span>}
                    <span class="tile__overlay" aria-hidden="true"></span>
                  </a>
                ) : (
                  <a class:list={['tile', paged && n >= pageSize && 'is-more']}
                    href={item.old_item_page ?? item.src}
                    data-full={item.src}
                    data-title={item.title}
                    data-item-page={item.old_item_page}
                    data-n={n}>
                    <img src={thumb(item.src)}
                      alt={item.alt || item.title || `${c.category} – Face2Face`}
                      loading={n < 6 ? 'eager' : 'lazy'}
                      decoding="async"
                      {...size(item.src)} />
                    {item.title && <span class="caption">{item.title}</span>}
                    <span class="tile__overlay" aria-hidden="true"></span>
                  </a>
                ),
              )}
              {paged && c.items.length > pageSize && (
                <p class="more more--panel">
                  <button type="button" class="btn btn--ghost" data-more>
                    הצג עוד <span class="more__count">({c.items.length - pageSize})</span>
                  </button>
                </p>
              )}
            </div>
          </div>
        );
      })
    }

    {
      limit && (
        <p class="more">
          <a class="btn btn--ghost" href="/עבודות">
            לכל העבודות
          </a>
        </p>
      )
    }
  </div>
</section>

<dialog class="lightbox" aria-label="תצוגה מוגדלת">
  <div class="lightbox__header">
    <p class="lightbox__title"></p>
    <div class="lightbox__actions">
      <a class="lightbox__link btn btn--ghost" href="#" target="_blank" rel="noopener" aria-label="פתח דף הפרויקט">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
        לדף הפרויקט
      </a>
      <button type="button" class="lightbox__close" aria-label="סגירה">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
  </div>
  <div class="lightbox__stage"></div>
</dialog>

<script>
  // ── Per-category 3D parallax ─────────────────────────────────────────────
  function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }
  function clamp(v: number, lo: number, hi: number) { return Math.max(lo, Math.min(hi, v)); }
  function easeInOut(t: number) { return t < 0.5 ? 2*t*t : -1+(4-2*t)*t; }

  // Respect user motion preference
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function initCatParallax(wrapper: HTMLElement) {
    if (prefersReducedMotion) return; // skip all parallax
    const banner = wrapper.querySelector<HTMLElement>('.cat-parallax__banner')!;
    const grid   = wrapper.querySelector<HTMLElement>('.cat-parallax__grid')!;
    const cols   = [...wrapper.querySelectorAll<HTMLElement>('.cat-parallax__col')];
    if (!banner || !grid) return;

    let progress = 0;
    let target   = 0;
    let raf      = 0;
    let started  = false;

    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting && !started) {
          started = true;
          tick();
        }
      });
    }, { threshold: 0.05 });
    io.observe(wrapper);

    function tick() {
      // Get scroll progress within this section
      const rect = wrapper.getBoundingClientRect();
      const vh = window.innerHeight;
      // 0 when banner top hits viewport bottom, 1 when banner bottom leaves viewport top
      target = clamp((vh - rect.top) / (rect.height + vh), 0, 1);
      progress = lerp(progress, target, 0.06);
      const p = easeInOut(progress);

      // Phase 1 (0→0.15): banner open (compact→full)
      const p1 = clamp(p / 0.15, 0, 1);
      const bw = lerp(88, 100, p1);
      const bh = lerp(72, 100, p1);
      const br = lerp(32, 0, p1);
      banner.style.width  = `${bw}%`;
      banner.style.height = `${bh}%`;
      banner.style.borderRadius = `${br}px`;
      banner.style.margin = `0 auto`;

      // Phase 2 (0.15→1): 3D rotation
      const p2 = clamp((p - 0.15) / 0.85, 0, 1);
      const rY  = lerp(-40, -6, p2);
      const rX  = lerp(22, 3, p2);
      const rZ  = lerp(12, 1, p2);
      const tZ  = lerp(-700, 0, p2);
      grid.style.transform = `rotateY(${rY}deg) rotateX(${rX}deg) rotateZ(${rZ}deg) translateZ(${tZ}px)`;

      // Column parallax offsets
      const offsets = [
        lerp(0, -35, p2),
        lerp(-30, 8, p2),
        lerp(0, -40, p2),
        lerp(-25, 18, p2),
      ];
      cols.forEach((col, ci) => {
        col.style.transform = `translateY(${offsets[ci] ?? 0}%)`;
      });

      raf = requestAnimationFrame(tick);
    }

    // Stop when panel becomes hidden
    const panel = wrapper.closest<HTMLElement>('[role=tabpanel]');
    if (panel) {
      const panelObs = new MutationObserver(() => {
        if (panel.hidden) cancelAnimationFrame(raf);
        else if (started) tick();
      });
      panelObs.observe(panel, { attributes: true, attributeFilter: ['hidden'] });
    }
  }

  document.querySelectorAll<HTMLElement>('[data-cat-parallax]').forEach(initCatParallax);

  // ── Tabs ─────────────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('#works').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
        });
        tab.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
        observeVisible();
      }),
    );
    // Arrow-key navigation (RTL: right = previous)
    tabs.forEach((tab, i) =>
      tab.addEventListener('keydown', (e) => {
        const k = (e as KeyboardEvent).key;
        const dir = k === 'ArrowLeft' ? 1 : k === 'ArrowRight' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        const next = tabs[(i + dir + tabs.length) % tabs.length];
        next.focus();
        next.click();
      }),
    );
  });

  // ── "הצג עוד" ─────────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('#works [data-more]').forEach((btn) => {
    const panel = btn.closest<HTMLElement>('[role=tabpanel]')!;
    const step = 24;
    btn.addEventListener('click', () => {
      const hidden = [...panel.querySelectorAll<HTMLElement>('.tile.is-more')];
      hidden.slice(0, step).forEach((t) => t.classList.remove('is-more'));
      const left = hidden.length - step;
      if (left <= 0) btn.closest('p')!.remove();
      else btn.querySelector('.more__count')!.textContent = `(${left})`;
      hidden[0]?.focus();
      observeVisible();
    });
  });

  // ── Scroll reveal ─────────────────────────────────────────────────────────
  function observeVisible() {
    const revealObs = new IntersectionObserver(
      (entries) => entries.forEach(e => {
        if (e.isIntersecting) {
          const el = e.target as HTMLElement;
          const n = parseInt(el.dataset.n || '0');
          el.style.transitionDelay = `${(n % 6) * 0.06}s`;
          el.classList.add('is-visible');
          revealObs.unobserve(el);
        }
      }),
      { threshold: 0.1 }
    );
    document.querySelectorAll<HTMLElement>('#works .tile:not(.is-visible):not(.is-more)').forEach(t => revealObs.observe(t));
  }
  observeVisible();

  // ── Lightbox ──────────────────────────────────────────────────────────────
  const box = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;
  const stage = box.querySelector<HTMLElement>('.lightbox__stage')!;
  const titleEl = box.querySelector<HTMLElement>('.lightbox__title')!;
  const linkEl = box.querySelector<HTMLAnchorElement>('.lightbox__link')!;

  box.querySelector('.lightbox__close')!.addEventListener('click', () => box.close());
  box.addEventListener('click', (e) => { if (e.target === box) box.close(); });
  box.addEventListener('close', () => { stage.innerHTML = ''; });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && box.open) box.close(); });

  document.querySelectorAll<HTMLAnchorElement>('#works .tile').forEach((tile) =>
    tile.addEventListener('click', (e) => {
      e.preventDefault();
      stage.innerHTML = '';
      const title = tile.dataset.title || '';
      const itemPage = tile.dataset.itemPage;

      if (tile.dataset.youtube) {
        const f = document.createElement('iframe');
        f.src = `https://www.youtube-nocookie.com/embed/${tile.dataset.youtube}?autoplay=1&rel=0`;
        f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        f.allowFullscreen = true;
        f.title = title || 'סרטון';
        stage.append(f);
      } else {
        const img = document.createElement('img');
        img.src = tile.dataset.full!;
        img.alt = title;
        stage.append(img);
      }

      titleEl.textContent = title;
      if (itemPage) {
        linkEl.href = itemPage;
        linkEl.style.display = '';
      } else {
        linkEl.style.display = 'none';
      }
      box.showModal();
    }),
  );
</script>

<style>
  .section-lead {
    text-align: center;
    color: var(--muted);
    margin: -0.5rem 0 2rem;
    font-size: 1rem;
  }

  /* ── Per-category parallax ─────────────────────────────────────── */
  .cat-parallax {
    perspective: 1200px;
    perspective-origin: 50% 40%;
    width: 100%;
    height: 380px;
    margin-bottom: 3rem;
    position: relative;
    overflow: hidden;
  }
  .cat-parallax__banner {
    position: absolute;
    inset: 0;
    width: 88%;
    height: 72%;
    margin: 0 auto;
    border-radius: 32px;
    overflow: hidden;
    transition: width 0.05s linear, height 0.05s linear, border-radius 0.05s linear;
    will-change: width, height, border-radius;
  }
  .cat-parallax__grid {
    display: flex;
    gap: 8px;
    height: 160%;
    margin-top: -30%;
    transform-origin: center center;
    will-change: transform;
  }
  .cat-parallax__col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    will-change: transform;
  }
  .cat-parallax__item {
    flex: none;
    height: 200px;
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-soft, #1a1725);
  }
  .cat-parallax__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cat-parallax__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: linear-gradient(
      to bottom,
      rgba(15,13,22,0.0) 0%,
      rgba(15,13,22,0.45) 60%,
      rgba(15,13,22,0.85) 100%
    );
    pointer-events: none;
  }
  .cat-parallax__label {
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    font-weight: 900;
    color: #fff;
    text-shadow: 0 2px 16px rgba(0,0,0,0.5);
    letter-spacing: -0.02em;
  }
  .cat-parallax__count {
    font-size: 1rem;
    font-weight: 600;
    color: var(--brand, #e10085);
    background: rgba(225,0,133,0.12);
    border: 1px solid rgba(225,0,133,0.3);
    border-radius: 999px;
    padding: 2px 14px;
  }
  @media (max-width: 640px) {
    .cat-parallax { height: 220px; border-radius: 14px; }
    .cat-parallax__item { height: 120px; border-radius: 8px; }
    .cat-parallax__grid { gap: 4px; margin-top: -20%; }
    .cat-parallax__label { font-size: 0.85rem; padding: 3px 10px 3px 6px; }
    .cat-parallax__count { font-size: 0.85rem; padding: 2px 10px; }
  }
  @media (max-width: 380px) {
    .cat-parallax { height: 190px; }
    .cat-parallax__item { height: 105px; }
  }

  /* ── Tabs ───────────────────────────────────────────────────────── */
  .tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0 0 2.5rem;
    padding: 0;
    list-style: none;
  }
  .tabs button {
    font: inherit;
    font-weight: 600;
    border: 1.5px solid var(--line);
    background: #fff;
    color: var(--ink);
    border-radius: 999px;
    padding: 0.5em 1.3em;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .tabs button:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  .tabs button[aria-selected='true'] {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
    box-shadow: 0 4px 16px rgba(225,0,133,0.3);
  }
  .tab__count {
    background: rgba(0,0,0,0.08);
    border-radius: 999px;
    padding: 1px 7px;
    font-size: 0.78rem;
    font-weight: 700;
  }
  button[aria-selected='true'] .tab__count {
    background: rgba(255,255,255,0.25);
  }

  /* ── Grid ────────────────────────────────────────────────────────── */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  .grid[hidden],
  .tile.is-more {
    display: none;
  }
  [role=tabpanel][hidden] { display: none; }
  .more--panel {
    grid-column: 1 / -1;
  }
  .tile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 12px;
    background: var(--bg-soft);
    opacity: 0;
    transform: scale(0.96) translateY(12px);
    transition: opacity 0.5s ease, transform 0.5s ease, box-shadow 0.3s ease;
  }
  .tile.is-visible {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
  .tile--video {
    aspect-ratio: 16 / 9;
    grid-column: span 2;
  }
  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.5s ease;
  }
  .tile:hover img {
    transform: scale(1.07);
  }
  .tile:hover {
    box-shadow: 0 12px 40px rgba(15,13,22,0.2);
    z-index: 1;
  }
  .tile__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(225,0,133,0) 50%, rgba(225,0,133,0.65) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .tile:hover .tile__overlay {
    opacity: 1;
  }
  .caption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 32px 14px 12px;
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.75));
    opacity: 0;
    transition: opacity 0.25s;
    z-index: 1;
  }
  .tile:hover .caption,
  .tile:focus-visible .caption,
  .tile--video .caption {
    opacity: 1;
  }
  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    border-radius: 50%;
    background: var(--brand);
    z-index: 1;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 20px rgba(225,0,133,0.4);
  }
  .tile:hover .play {
    transform: scale(1.1);
    box-shadow: 0 8px 28px rgba(225,0,133,0.55);
  }
  .play::after {
    content: '';
    position: absolute;
    left: 26px;
    top: 20px;
    border-style: solid;
    border-width: 12px 0 12px 18px;
    border-color: transparent transparent transparent #fff;
  }
  .more {
    text-align: center;
    margin: 2rem 0 0;
  }

  /* ── Lightbox ────────────────────────────────────────────────────── */
  .lightbox {
    width: min(1100px, 100% - 24px);
    max-height: 95vh;
    padding: 0;
    border: 0;
    background: rgba(12, 10, 18, 0.97);
    border-radius: 16px;
    color: #fff;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0,0,0,0.7);
  }
  .lightbox::backdrop {
    background: rgba(8, 6, 14, 0.88);
    backdrop-filter: blur(4px);
  }
  .lightbox__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    gap: 12px;
  }
  .lightbox__title {
    margin: 0;
    font-weight: 700;
    font-size: 1rem;
    color: rgba(255,255,255,0.9);
  }
  .lightbox__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .lightbox__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    font-size: 0.85rem;
    color: #fff;
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .lightbox__link:hover {
    background: rgba(255,255,255,0.1);
  }
  .lightbox__close {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 0;
    background: rgba(255,255,255,0.1);
    color: #fff;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.2s;
    flex-shrink: 0;
  }
  .lightbox__close:hover { background: rgba(255,255,255,0.2); }
  .lightbox__stage {
    padding: 16px;
    display: grid;
    place-items: center;
    min-height: 200px;
    max-height: calc(95vh - 80px);
    overflow: auto;
  }
  .lightbox__stage :global(img) {
    max-height: calc(95vh - 120px);
    max-width: 100%;
    width: auto;
    border-radius: 8px;
  }
  .lightbox__stage :global(iframe) {
    width: min(860px, 100%);
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 8px;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    .tile--video { grid-column: span 2; }
    .tile__actions { gap: 6px; }
    .tile__actions button,
    .tile__actions a {
      width: 34px;
      height: 34px;
      font-size: 0.78rem;
    }
  }
  @media (max-width: 380px) {
    .grid { gap: 6px; }
  }

  /* Sticky, swipeable category tabs */
  .tabs {
    position: sticky;
    top: 70px;
    z-index: 20;
    padding: 10px 0;
