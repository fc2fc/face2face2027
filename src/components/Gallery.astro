---
import Icon from './Icon.astro';
import { Picture } from 'astro:assets';
import { site, asset, imageUrl } from '../lib/content';
import focalData from '../data/focal.json';
import videosData from '../data/videos.json';

interface Props {
  limit?: number;
  pageSize?: number;
  headingLevel?: 'h1' | 'h2';
}
const { limit, headingLevel = 'h2', pageSize = 24 } = Astro.props;
const paged = !limit;
const Heading = headingLevel;
const categories = site.portfolio as { category: string; items: any[] }[];
// On the home page the gallery is far below the fold; on /עבודות the first row is on screen.
const aboveFold = headingLevel === 'h1';

const focal = focalData as Record<string, { x: number; y: number; n: number; w?: number }>;
// Small faces in wide shots get a gentle pre-zoom anchored on the face, so the subject — not empty space — fills the tile.
const zoomOf = (src?: string) => {
  const f = src ? focal[src] : undefined;
  return f && f.n && f.w ? Math.min(2, Math.max(1, 17 / f.w)).toFixed(2) : '1';
};

// Lightbox shows a 1600px WebP instead of the 2000px source.
const shown = categories.flatMap((c) => (limit ? c.items.slice(0, limit) : c.items)).filter((i) => i.src);
const fullUrl = new Map(await Promise.all(shown.map(async (i) => [i.src, await imageUrl(i.src, 1600)] as const)));

/**
 * Tile shape from the photo itself:
 *  - portrait            → tall   (1 col × 2 rows)  – faces stay big and centred
 *  - landscape + faces ≥2 / group → wide (2 cols × 2 rows)
 *  - landscape, single subject    → std  (1 col × 1 row)
 *  - videos                       → wide
 */
function shapeOf(item: any): 'tall' | 'wide' | 'std' {
  if (item.type === 'video' || item.feature) return 'wide';
  let meta: ImageMetadata | undefined;
  try { meta = asset(item.src); } catch { /* ignore */ }
  const ratio = meta ? meta.width / meta.height : 1;
  const f = focal[item.src];
  if (ratio < 0.95) return 'tall';
  if (ratio >= 0.95 && ratio < 1.2) return 'tall';
  if (f && f.n >= 2) return 'wide';
  return 'std';
}
// The face pre-zoom above scales the rendered <img> with a CSS transform, so a tile showing
// at e.g. 300px CSS width but zoomed ×1.6 is really displaying ~480px of image content.
// `sizes` only describes the box, not the transform, so without this the browser picks a
// srcset candidate sized for the box and the zoom stretches it soft. Scaling the sizes
// value by the same zoom factor makes the browser request a correspondingly larger image —
// extra resolution only for the tiles that are actually zoomed, not across the board.
const sizesFor = (shape: string, zoom = 1) => {
  const mobileVw = shape === 'wide' ? 100 : 50;
  const desktopPx = shape === 'wide' ? 600 : 300;
  return zoom <= 1.01
    ? `(max-width: 640px) ${mobileVw}vw, ${desktopPx}px`
    : `(max-width: 640px) ${Math.round(mobileVw * zoom)}vw, ${Math.round(desktopPx * zoom)}px`;
};
// VideoObject structured data for the full gallery page (/עבודות), so the videos can show with a thumbnail in Google.
const SITE = 'https://www.fc2fc.co.il';
const videoMeta = videosData as Record<string, { name: string; description: string; uploadDate: string; duration: string }>;
const videoSchema = paged
  ? {
      '@context': 'https://schema.org',
      '@graph': categories
        .flatMap((c) => c.items)
        .filter((i) => i.type === 'video' && videoMeta[i.youtube_id])
        .map((i) => {
          const v = videoMeta[i.youtube_id];
          return {
            '@type': 'VideoObject',
            name: v.name,
            description: v.description,
            uploadDate: v.uploadDate,
            duration: v.duration,
            thumbnailUrl: [`https://i.ytimg.com/vi/${i.youtube_id}/hqdefault.jpg`],
            embedUrl: `https://www.youtube.com/embed/${i.youtube_id}`,
            url: `${SITE}${encodeURI(i.item_page ?? '/work')}`,
            inLanguage: 'he',
            creator: { '@id': `${SITE}/#naga-malasa` },
          };
        }),
    }
  : null;
const pos = (src?: string) => {
  const f = src ? focal[src] : undefined;
  return f ? `${f.x}% ${f.y}%` : '50% 30%';
};
---

{videoSchema && videoSchema['@graph'].length > 0 && <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />}

<section class="section works" id="works">
  <div class="container">
    <Heading class="section-title">עבודות</Heading>
    <p class="section-lead">מבחר מהעבודות שלנו – לחצו על כל תמונה לצפייה מורחבת</p>

    <div class="tabs" role="tablist" aria-label="קטגוריות עבודות">
      <div class="tabs__track">
        <span class="tabs__ind" aria-hidden="true"></span>
        {
          categories.map((c, i) => (
            <button type="button" role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'}>
              <span class="tab__label">{c.category}</span>
              <span class="tab__count">{c.items.length}</span>
            </button>
          ))
        }
      </div>
    </div>

    {
      categories.map((c, i) => {
        const items = limit ? c.items.slice(0, limit) : c.items;
        return (
          <div role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} hidden={i !== 0}>
            <div class="grid">
              {items.map((item, n) => {
                const shape = shapeOf(item);
                const isVideo = item.type === 'video';
                const src = isVideo ? item.thumbnail : item.src;
                const f = focal[src];
                const eager = aboveFold && i === 0 && n < 4;
                const zoom = isVideo ? 1 : parseFloat(zoomOf(src));
                return (
                  <a
                    class:list={['tile', `tile--${shape}`, shape === 'std' && n % 6 === 4 && 'tile--bento', isVideo && 'tile--video', paged && n >= pageSize && 'is-more']}
                    href={isVideo ? item.item_page ?? item.url : item.item_page ?? fullUrl.get(item.src)}
                    data-full={isVideo ? undefined : fullUrl.get(item.src)}
                    data-youtube={isVideo ? item.youtube_id : undefined}
                    data-title={item.title}
                    data-item-page={item.item_page}
                    data-n={n}
                    style={`--fx:${f ? f.x : 50}%;--fy:${f ? f.y : 30}%;--z:${isVideo ? 1 : zoomOf(src)}`}
                  >
                    <Picture
                      src={asset(src)}
                      alt={item.alt || item.title || (isVideo ? 'סרטון' : `${c.category} – Face2Face`)}
                      widths={zoom > 1.01 ? [300, 450, 600, 900, 1200, 1600] : [300, 450, 600, 900, 1200]}
                      sizes={sizesFor(shape, zoom)}
                      formats={['avif']}
                      fallbackFormat="webp"
                      loading={eager ? 'eager' : 'lazy'}
                      fetchpriority={aboveFold && i === 0 && n === 0 ? 'high' : undefined}
                      decoding="async"
                      style={`object-position:${pos(src)}`}
                    />
                    <span class="tile__shade" aria-hidden="true"></span>
                    <span class="tile__glow" aria-hidden="true"></span>
                    {isVideo && (
                      <span class="play" aria-hidden="true">
                        <Icon name="play-fill" size={26} />
                      </span>
                    )}
                    {!isVideo && (
                      <span class="tile__zoom" aria-hidden="true">
                        <Icon name="arrows-out-simple" size={18} />
                      </span>
                    )}
                    <span class:list={['info', !item.title && !isVideo && 'info--bare']}>
                      <span class="info__text">
                        <span class="info__cat">{c.category}</span>
                        {item.title && <span class="info__title">{item.title}</span>}
                      </span>
                      <span class="info__go" aria-hidden="true">
                        <Icon name="arrow-left" size={16} />
                      </span>
                    </span>
                  </a>
                );
              })}
            </div>
            {paged && c.items.length > pageSize && (
              <p class="more more--panel">
                <button type="button" class="btn btn--ghost" data-more>
                  הצג עוד <span class="more__count">({c.items.length - pageSize})</span>
                </button>
              </p>
            )}
          </div>
        );
      })
    }

    {
      limit && (
        <p class="more">
          <a class="btn btn--ghost" href="/work">
            לכל העבודות
          </a>
        </p>
      )
    }
  </div>
</section>

<dialog class="lightbox" aria-label="תצוגה מוגדלת">
  <div class="lightbox__bar">
    <span class="lightbox__count" aria-live="polite"></span>
    <p class="lightbox__title"></p>
    <div class="lightbox__actions">
      <a class="lightbox__link" href="#" target="_blank" rel="noopener">
        לדף הפרויקט
        <Icon name="arrow-left" size={16} />
      </a>
      <button type="button" class="lightbox__btn lightbox__close" aria-label="סגירה">
        <Icon name="x" size={20} />
      </button>
    </div>
  </div>
  <div class="lightbox__stage"></div>
  <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--prev" aria-label="הקודם">
    <Icon name="arrow-right" size={22} />
  </button>
  <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--next" aria-label="הבא">
    <Icon name="arrow-left" size={22} />
  </button>
</dialog>

<div class="gcursor" aria-hidden="true">
  <span class="gcursor__dot"></span>
  <span class="gcursor__view">צפה</span>
</div>

<script>
  const root = document.querySelector<HTMLElement>('#works')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Tabs with sliding indicator ──────────────────────────────────────────
  const track = root.querySelector<HTMLElement>('.tabs__track')!;
  const ind = root.querySelector<HTMLElement>('.tabs__ind')!;
  const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];

  function moveInd(animate = true) {
    const on = tabs.find((t) => t.getAttribute('aria-selected') === 'true');
    if (!on) return;
    const tr = track.getBoundingClientRect();
    const r = on.getBoundingClientRect();
    if (!animate) ind.style.transition = 'none';
    ind.style.width = `${r.width}px`;
    ind.style.height = `${r.height}px`;
    ind.style.transform = `translate(${r.left - tr.left}px, ${r.top - tr.top}px)`;
    if (!animate) { void ind.offsetWidth; ind.style.transition = ''; }
  }
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        const panel = document.getElementById(t.getAttribute('aria-controls')!)!;
        const wasHidden = panel.hidden;
        panel.hidden = !on;
        if (on && wasHidden) {
          panel.classList.remove('is-entering');
          void panel.offsetWidth;
          panel.classList.add('is-entering');
        }
      });
      moveInd();
      tab.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
      observeVisible();
    }),
  );
  // Arrow-key navigation (RTL: right = previous)
  tabs.forEach((tab, i) =>
    tab.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      const dir = k === 'ArrowLeft' ? 1 : k === 'ArrowRight' ? -1 : 0;
      if (!dir) return;
      e.preventDefault();
      const next = tabs[(i + dir + tabs.length) % tabs.length];
      next.focus();
      next.click();
    }),
  );
  moveInd(false);
  addEventListener('resize', () => moveInd(false));
  document.fonts?.ready.then(() => moveInd(false));
  setTimeout(() => moveInd(false), 400);

  // ── "הצג עוד" ─────────────────────────────────────────────────────────────
  root.querySelectorAll<HTMLButtonElement>('[data-more]').forEach((btn) => {
    const panel = btn.closest<HTMLElement>('[role=tabpanel]')!;
    const step = 24;
    btn.addEventListener('click', () => {
      const hidden = [...panel.querySelectorAll<HTMLElement>('.tile.is-more')];
      hidden.slice(0, step).forEach((t) => t.classList.remove('is-more'));
      const left = hidden.length - step;
      if (left <= 0) btn.closest('p')!.remove();
      else btn.querySelector('.more__count')!.textContent = `(${left})`;
      hidden[0]?.focus();
      observeVisible();
    });
  });

  // ── Staggered reveal as tiles scroll in ───────────────────────────────────
  let revealObs: IntersectionObserver | null = null;
  function observeVisible() {
    revealObs ??= new IntersectionObserver(
      (entries) => {
        let k = 0;
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          el.style.transitionDelay = reduce ? '0s' : `${Math.min(k++, 8) * 0.07}s`;
          el.classList.add('is-visible');
          revealObs!.unobserve(el);
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -4% 0px' },
    );
    root.querySelectorAll<HTMLElement>('.tile:not(.is-visible):not(.is-more)').forEach((t) => revealObs!.observe(t));
  }
  observeVisible();

  // ── Lightbox with prev / next, keyboard, swipe, morph transition and zoom ──
  const box = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;
  const stage = box.querySelector<HTMLElement>('.lightbox__stage')!;
  const titleEl = box.querySelector<HTMLElement>('.lightbox__title')!;
  const countEl = box.querySelector<HTMLElement>('.lightbox__count')!;
  const linkEl = box.querySelector<HTMLAnchorElement>('.lightbox__link')!;
  let list: HTMLAnchorElement[] = [];
  let idx = 0;

  // ── Morph dissolve between slides: one WebGL pass over two textures, lazily
  // compiled on the first next/prev click so the gallery page itself never
  // pays for it. Letterboxed like the resting <img> (object-fit: contain) so
  // the frame doesn't jump when the transition hands off to the real <img>.
  // Falls back to the existing crossfade for video, first open, reduced
  // motion, or when WebGL just isn't there.
  const MORPH_VERT = `
attribute vec2 a_position;
varying vec2 v_uv;
void main() {
  v_uv = a_position * 0.5 + 0.5;
  gl_Position = vec4(a_position, 0.0, 1.0);
}
`;
  const MORPH_FRAG = `
precision highp float;
uniform sampler2D u_from;
uniform sampler2D u_to;
uniform float u_progress;
uniform vec2 u_resolution;
uniform float u_fromAspect;
uniform float u_toAspect;
uniform float u_direction;
uniform vec3 u_bg;
varying vec2 v_uv;

vec3 permute(vec3 x) { return mod(((x * 34.0) + 1.0) * x, 289.0); }
float snoise(vec2 v) {
  const vec4 C = vec4(0.211324865405187, 0.366025403784439, -0.577350269189626, 0.024390243902439);
  vec2 i  = floor(v + dot(v, C.yy));
  vec2 x0 = v - i + dot(i, C.xx);
  vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
  vec4 x12 = x0.xyxy + C.xxzz;
  x12.xy -= i1;
  i = mod(i, 289.0);
  vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));
  vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
  m = m * m; m = m * m;
  vec3 x = 2.0 * fract(p * C.www) - 1.0;
  vec3 h = abs(x) - 0.5;
  vec3 ox = floor(x + 0.5);
  vec3 a0 = x - ox;
  m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);
  vec3 g;
  g.x = a0.x * x0.x + h.x * x0.y;
  g.yz = a0.yz * x12.xz + h.yz * x12.yw;
  return 130.0 * dot(m, g);
}
float fbm(vec2 v) {
  float value = 0.0; float amp = 0.5;
  for (int i = 0; i < 5; i++) { value += amp * snoise(v); v *= 2.0; amp *= 0.5; }
  return value;
}
// object-fit: contain, expressed as a UV window; outside [0,1] reads as background.
vec2 containUV(vec2 uv, float imgAspect) {
  float canvasAspect = u_resolution.x / u_resolution.y;
  vec2 inv = (canvasAspect > imgAspect) ? vec2(canvasAspect / imgAspect, 1.0) : vec2(1.0, imgAspect / canvasAspect);
  return (uv - 0.5) * inv + 0.5;
}
bool inBounds(vec2 uv) { return uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0; }

void main() {
  float edge = 0.14;
  float drift = 0.035;
  float adjusted = u_progress * (1.0 + 2.0 * edge) - edge;

  vec2 fromUV = containUV(v_uv + vec2(0.0, fbm(v_uv * 2.0) * u_progress * drift * u_direction), u_fromAspect);
  vec2 toUV = containUV(v_uv + vec2(0.0, fbm(v_uv * 2.0 + 4.0) * (1.0 - u_progress) * -0.5 * drift * u_direction), u_toAspect);

  vec3 fromColor = inBounds(fromUV) ? texture2D(u_from, fromUV).rgb : u_bg;
  vec3 toColor = inBounds(toUV) ? texture2D(u_to, toUV).rgb : u_bg;

  // The threshold is biased by the incoming frame's own brightness, so its lit
  // areas burn through the outgoing frame first rather than dissolving evenly.
  float noise = fbm(v_uv * 3.4 + vec2(0.0, u_progress * u_direction)) * 0.5 + 0.5;
  noise = smoothstep(0.0, 2.0, length(toColor) + noise);
  float mixFactor = 1.0 - smoothstep(adjusted - edge, adjusted + edge, noise);

  gl_FragColor = vec4(mix(fromColor, toColor, mixFactor), 1.0);
}
`;
  const BG: readonly [number, number, number] = [8 / 255, 8 / 255, 8 / 255];
  let glCanvas: HTMLCanvasElement | null = null;
  let gl: WebGLRenderingContext | null = null;
  let glProgram: WebGLProgram | null = null;
  let glUniforms: Record<string, WebGLUniformLocation | null> = {};
  let glSupported: boolean | null = null;

  function compileShader(ctx: WebGLRenderingContext, type: number, src: string) {
    const sh = ctx.createShader(type);
    if (!sh) return null;
    ctx.shaderSource(sh, src);
    ctx.compileShader(sh);
    if (!ctx.getShaderParameter(sh, ctx.COMPILE_STATUS)) { ctx.deleteShader(sh); return null; }
    return sh;
  }

  function ensureGL(): boolean {
    if (glSupported !== null) return glSupported;
    try {
      glCanvas = document.createElement('canvas');
      glCanvas.className = 'lightbox__gl';
      glCanvas.setAttribute('aria-hidden', 'true');
      const ctx = (glCanvas.getContext('webgl', { alpha: false, antialias: false }) ??
        glCanvas.getContext('experimental-webgl')) as WebGLRenderingContext | null;
      if (!ctx) throw new Error('no webgl');
      const vert = compileShader(ctx, ctx.VERTEX_SHADER, MORPH_VERT);
      const frag = compileShader(ctx, ctx.FRAGMENT_SHADER, MORPH_FRAG);
      if (!vert || !frag) throw new Error('shader compile failed');
      const prog = ctx.createProgram();
      if (!prog) throw new Error('no program');
      ctx.attachShader(prog, vert);
      ctx.attachShader(prog, frag);
      ctx.linkProgram(prog);
      ctx.deleteShader(vert);
      ctx.deleteShader(frag);
      if (!ctx.getProgramParameter(prog, ctx.LINK_STATUS)) throw new Error('link failed');
      ctx.useProgram(prog);
      const buf = ctx.createBuffer();
      ctx.bindBuffer(ctx.ARRAY_BUFFER, buf);
      ctx.bufferData(ctx.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), ctx.STATIC_DRAW);
      const loc = ctx.getAttribLocation(prog, 'a_position');
      ctx.enableVertexAttribArray(loc);
      ctx.vertexAttribPointer(loc, 2, ctx.FLOAT, false, 0, 0);
      const u: Record<string, WebGLUniformLocation | null> = {};
      ['from', 'to', 'progress', 'resolution', 'fromAspect', 'toAspect', 'direction', 'bg'].forEach((n) => {
        u['u_' + n] = ctx.getUniformLocation(prog, 'u_' + n);
      });
      gl = ctx; glProgram = prog; glUniforms = u;
      glSupported = true;
    } catch { glSupported = false; }
    return glSupported;
  }

  function makeTexture(ctx: WebGLRenderingContext, source: TexImageSource) {
    const tex = ctx.createTexture()!;
    ctx.bindTexture(ctx.TEXTURE_2D, tex);
    ctx.pixelStorei(ctx.UNPACK_FLIP_Y_WEBGL, true);
    ctx.texImage2D(ctx.TEXTURE_2D, 0, ctx.RGBA, ctx.RGBA, ctx.UNSIGNED_BYTE, source);
    ctx.texParameteri(ctx.TEXTURE_2D, ctx.TEXTURE_WRAP_S, ctx.CLAMP_TO_EDGE);
    ctx.texParameteri(ctx.TEXTURE_2D, ctx.TEXTURE_WRAP_T, ctx.CLAMP_TO_EDGE);
    ctx.texParameteri(ctx.TEXTURE_2D, ctx.TEXTURE_MIN_FILTER, ctx.LINEAR);
    ctx.texParameteri(ctx.TEXTURE_2D, ctx.TEXTURE_MAG_FILTER, ctx.LINEAR);
    return tex;
  }

  function loadImageEl(src: string) {
    return new Promise<HTMLImageElement>((resolve, reject) => {
      const img = new Image();
      img.decoding = 'async';
      img.onload = () => resolve(img);
      img.onerror = () => reject(new Error('load failed'));
      img.src = src;
    });
  }

  function easeInOutQuint(t: number) {
    const x = Math.min(Math.max(t, 0), 1);
    return x < 0.5 ? 16 * x ** 5 : 1 - (-2 * x + 2) ** 5 / 2;
  }

  function runMorph(fromEl: HTMLImageElement, toImg: HTMLImageElement, direction: number, duration: number): Promise<void> {
    return new Promise((resolve) => {
      if (!ensureGL() || !gl || !glProgram || !glCanvas) { resolve(); return; }
      const ctx = gl;
      stage.appendChild(glCanvas);
      const rect = glCanvas.getBoundingClientRect(); // the inset CSS box, same area the <img> sits in
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.max(1, Math.round(rect.width * dpr));
      const h = Math.max(1, Math.round(rect.height * dpr));
      glCanvas.width = w;
      glCanvas.height = h;
      fromEl.style.visibility = 'hidden'; // keeps its box (and layout) while the canvas plays over it
      ctx.viewport(0, 0, w, h);
      ctx.useProgram(glProgram);
      const fromTex = makeTexture(ctx, fromEl);
      const toTex = makeTexture(ctx, toImg);
      const fromAspect = fromEl.naturalWidth / Math.max(fromEl.naturalHeight, 1);
      const toAspect = toImg.naturalWidth / Math.max(toImg.naturalHeight, 1);
      const start = performance.now();
      const dur = Math.max(duration, 1);
      const finish = () => {
        ctx.deleteTexture(fromTex);
        ctx.deleteTexture(toTex);
        glCanvas?.remove();
        fromEl.style.visibility = '';
        resolve();
      };
      const frame = (now: number) => {
        if (!box.open) { finish(); return; }
        const p = easeInOutQuint((now - start) / dur);
        ctx.activeTexture(ctx.TEXTURE0); ctx.bindTexture(ctx.TEXTURE_2D, fromTex); ctx.uniform1i(glUniforms.u_from, 0);
        ctx.activeTexture(ctx.TEXTURE1); ctx.bindTexture(ctx.TEXTURE_2D, toTex); ctx.uniform1i(glUniforms.u_to, 1);
        ctx.uniform1f(glUniforms.u_progress, p);
        ctx.uniform2f(glUniforms.u_resolution, w, h);
        ctx.uniform1f(glUniforms.u_fromAspect, fromAspect);
        ctx.uniform1f(glUniforms.u_toAspect, toAspect);
        ctx.uniform1f(glUniforms.u_direction, direction);
        ctx.uniform3f(glUniforms.u_bg, BG[0], BG[1], BG[2]);
        ctx.drawArrays(ctx.TRIANGLE_STRIP, 0, 4);
        if (now - start < dur) requestAnimationFrame(frame);
        else finish();
      };
      requestAnimationFrame(frame);
    });
  }

  // ── Pinch / wheel / drag zoom on the open image, reset on every navigation ──
  const zoomCtl = new WeakMap<HTMLImageElement, { reset: () => void; step: (dir: number) => void }>();
  function attachZoomPan(img: HTMLImageElement) {
    let scale = 1, panX = 0, panY = 0;
    const MIN = 1, MAX = 4;
    const apply = () => {
      img.style.transform = scale > 1.001 ? `translate(${panX}px, ${panY}px) scale(${scale})` : '';
      img.style.touchAction = scale > 1.001 ? 'none' : 'pan-y';
      img.classList.toggle('is-zoomed', scale > 1.001);
    };
    const clampPan = () => {
      const r = img.getBoundingClientRect();
      const baseW = r.width / scale, baseH = r.height / scale;
      const maxX = Math.max(0, (baseW * scale - baseW) / 2);
      const maxY = Math.max(0, (baseH * scale - baseH) / 2);
      panX = Math.min(maxX, Math.max(-maxX, panX));
      panY = Math.min(maxY, Math.max(-maxY, panY));
    };
    const zoomAt = (clientX: number, clientY: number, next: number) => {
      const r = img.getBoundingClientRect();
      const cx = clientX - (r.left + r.width / 2);
      const cy = clientY - (r.top + r.height / 2);
      const ratio = next / scale;
      panX = cx - (cx - panX) * ratio;
      panY = cy - (cy - panY) * ratio;
      scale = next;
      clampPan();
      apply();
    };
    img.addEventListener('wheel', (e) => {
      e.preventDefault();
      zoomAt(e.clientX, e.clientY, Math.min(MAX, Math.max(MIN, scale * (e.deltaY < 0 ? 1.18 : 1 / 1.18))));
    }, { passive: false });
    img.addEventListener('dblclick', (e) => zoomAt(e.clientX, e.clientY, scale > 1.001 ? 1 : 2.5));

    const pointers = new Map<number, { x: number; y: number }>();
    let pinchStartDist = 0, pinchStartScale = 1;
    let dragStart: { x: number; y: number; panX: number; panY: number } | null = null;
    let suppressBubble = false;
    img.addEventListener('pointerdown', (e) => {
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pointers.size >= 2 || scale > 1.001) {
        suppressBubble = true;
        e.stopPropagation();
        img.setPointerCapture(e.pointerId);
      }
      if (pointers.size === 1 && scale > 1.001) dragStart = { x: e.clientX, y: e.clientY, panX, panY };
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        pinchStartDist = Math.hypot(a.x - b.x, a.y - b.y) || 1;
        pinchStartScale = scale;
        dragStart = null;
      }
    });
    img.addEventListener('pointermove', (e) => {
      if (!pointers.has(e.pointerId)) return;
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        const dist = Math.hypot(a.x - b.x, a.y - b.y) || 1;
        const mid = { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
        zoomAt(mid.x, mid.y, Math.min(MAX, Math.max(MIN, pinchStartScale * (dist / pinchStartDist))));
      } else if (dragStart) {
        panX = dragStart.panX + (e.clientX - dragStart.x);
        panY = dragStart.panY + (e.clientY - dragStart.y);
        clampPan();
        apply();
      }
    });
    const release = (e: PointerEvent) => {
      pointers.delete(e.pointerId);
      if (pointers.size < 2) pinchStartDist = 0;
      if (pointers.size === 0) { dragStart = null; if (suppressBubble) { e.stopPropagation(); suppressBubble = false; } }
    };
    img.addEventListener('pointerup', release);
    img.addEventListener('pointercancel', release);
    zoomCtl.set(img, {
      reset: () => { scale = 1; panX = 0; panY = 0; apply(); },
      step: (dir: number) => zoomAt(innerWidth / 2, innerHeight / 2, Math.min(MAX, Math.max(MIN, scale + dir * 0.6))),
    });
    apply();
  }

  let restingImg: HTMLImageElement | null = null;
  let transitioning = false;

  function makeSlideEl(tile: HTMLAnchorElement, title: string): HTMLElement {
    if (tile.dataset.youtube) {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${tile.dataset.youtube}?autoplay=1&rel=0`;
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      f.title = title || 'סרטון';
      restingImg = null;
      return f;
    }
    const img = document.createElement('img');
    img.src = tile.dataset.full!;
    img.alt = title;
    img.decoding = 'async';
    attachZoomPan(img);
    restingImg = img;
    return img;
  }

  async function show(i: number, dir = 0) {
    if (transitioning) return; // a morph is already mid-flight; ignore the repeat click
    const nextIdx = (i + list.length) % list.length;
    const tile = list[nextIdx];
    const title = tile.dataset.title || '';
    const isVideo = !!tile.dataset.youtube;
    const canMorph = dir !== 0 && !isVideo && restingImg && !reduce && tile.dataset.full && ensureGL();

    if (canMorph) {
      transitioning = true;
      try {
        const toImg = await loadImageEl(tile.dataset.full!);
        if (!box.open) return; // closed while the next image was loading
        await runMorph(restingImg!, toImg, dir, 650);
        restingImg!.remove();
        stage.appendChild(makeSlideEl(tile, title));
      } finally {
        transitioning = false;
      }
    } else {
      stage.innerHTML = '';
      const el = makeSlideEl(tile, title);
      if (dir && !reduce) {
        el.style.animation = `lb-in 0.4s cubic-bezier(.2,.7,.2,1)`;
        el.style.setProperty('--from', dir > 0 ? '-40px' : '40px');
      }
      stage.append(el);
    }

    idx = nextIdx;
    titleEl.textContent = title;
    countEl.textContent = `${idx + 1} / ${list.length}`;
    const itemPage = tile.dataset.itemPage;
    if (itemPage) { linkEl.href = itemPage; linkEl.style.display = ''; } else linkEl.style.display = 'none';

    // warm the neighbours
    if (!isVideo) {
      [1, -1].forEach((d) => {
        const n = list[(idx + d + list.length) % list.length];
        if (!n.dataset.youtube && n.dataset.full) { const p = new Image(); p.src = n.dataset.full; }
      });
    }
  }

  root.querySelectorAll<HTMLAnchorElement>('.tile').forEach((tile) =>
    tile.addEventListener('click', (e) => {
      e.preventDefault();
      const panel = tile.closest<HTMLElement>('[role=tabpanel]')!;
      list = [...panel.querySelectorAll<HTMLAnchorElement>('.tile')];
      show(list.indexOf(tile));
      hideCursor();
      box.showModal();
    }),
  );
  // RTL: "next" is visually on the left
  box.querySelector('.lightbox__nav--next')!.addEventListener('click', () => show(idx + 1, 1));
  box.querySelector('.lightbox__nav--prev')!.addEventListener('click', () => show(idx - 1, -1));
  box.querySelector('.lightbox__close')!.addEventListener('click', () => box.close());
  box.addEventListener('click', (e) => { if (e.target === box) box.close(); });
  box.addEventListener('close', () => { stage.innerHTML = ''; restingImg = null; transitioning = false; });
  box.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') { e.preventDefault(); show(idx + 1, 1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); show(idx - 1, -1); }
    if (!restingImg) return;
    if (e.key === '+' || e.key === '=') { e.preventDefault(); zoomCtl.get(restingImg)?.step(1); }
    if (e.key === '-') { e.preventDefault(); zoomCtl.get(restingImg)?.step(-1); }
    if (e.key === '0') { e.preventDefault(); zoomCtl.get(restingImg)?.reset(); }
  });
  let sx = 0;
  stage.addEventListener('pointerdown', (e) => { sx = e.clientX; });
  stage.addEventListener('pointerup', (e) => {
    const dx = e.clientX - sx;
    if (Math.abs(dx) > 60) show(idx + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
  });

  // ── Hover FX: cursor-tracking glow + gentle tilt + custom trailing cursor ───
  // Mouse/pen only. Touch gets the plain states from the CSS (no listeners, no cursor).
  // Pointer events only record coordinates; all DOM writes happen once per animation frame.
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
  const cursorEl = document.querySelector<HTMLElement>('.gcursor')!;
  const grids = [...root.querySelectorAll<HTMLElement>('.grid')];
  let px = 0, py = 0;            // last pointer position (viewport)
  let cx = 0, cy = 0;            // trailing cursor position
  let over: HTMLElement | null = null;
  let rect: DOMRect | null = null;
  let paintRaf = 0, trailRaf = 0;
  let rectStale = false;

  function paint() {
    paintRaf = 0;
    if (!over) return;
    if (rectStale) { rect = over.getBoundingClientRect(); rectStale = false; }
    const x = px - rect!.left, y = py - rect!.top;
    over.style.setProperty('--gx', `${x.toFixed(1)}px`);
    over.style.setProperty('--gy', `${y.toFixed(1)}px`);
    if (!reduce) {
      over.style.setProperty('--ry', `${((x / rect!.width - 0.5) * 12).toFixed(2)}deg`);
      over.style.setProperty('--rx', `${(-(y / rect!.height - 0.5) * 12).toFixed(2)}deg`);
    }
  }
  function trail() {
    trailRaf = 0;
    const k = reduce ? 1 : 0.2; // reduced motion: follow instantly, no smoothing
    cx += (px - cx) * k;
    cy += (py - cy) * k;
    cursorEl.style.transform = `translate3d(${cx.toFixed(1)}px, ${cy.toFixed(1)}px, 0)`;
    if (Math.abs(px - cx) > 0.2 || Math.abs(py - cy) > 0.2) trailRaf = requestAnimationFrame(trail); // idle → loop stops
  }
  function setOver(tile: HTMLElement | null) {
    if (tile === over) return;
    if (over) { over.style.setProperty('--rx', '0deg'); over.style.setProperty('--ry', '0deg'); }
    over = tile;
    rect = tile ? tile.getBoundingClientRect() : null; // measured before the tilt starts
    rectStale = false;
    cursorEl.classList.toggle('is-view', !!tile);
  }
  function hideCursor() {
    cursorEl.classList.remove('is-on', 'is-view');
    setOver(null);
  }
  function onMove(e: PointerEvent) {
    if (e.pointerType === 'touch') return;
    px = e.clientX; py = e.clientY;
    const wasHidden = !cursorEl.classList.contains('is-on');
    if (wasHidden) { cx = px; cy = py; cursorEl.classList.add('is-on'); } // appear in place, don't fly in from the old spot
    setOver((e.target as Element).closest<HTMLElement>('.tile'));
    if (!paintRaf) paintRaf = requestAnimationFrame(paint);
    if (!trailRaf) trailRaf = requestAnimationFrame(trail);
  }
  // Scrolling moves tiles under a still pointer: re-resolve the tile and refresh its rect
  let scrollRaf = 0;
  function onScroll() {
    if (scrollRaf || !cursorEl.classList.contains('is-on')) return;
    scrollRaf = requestAnimationFrame(() => {
      scrollRaf = 0;
      const el = document.elementFromPoint(px, py);
      if (!el?.closest('.grid')) { hideCursor(); return; }
      const t = el.closest<HTMLElement>('.tile');
      if (t === over) { rectStale = true; if (!paintRaf) paintRaf = requestAnimationFrame(paint); } else setOver(t);
    });
  }
  function syncFx() {
    const on = finePointer.matches;
    root.classList.toggle('has-cursor', on); // CSS hides the system cursor over the tiles only while this is set
    if (!on) hideCursor();
  }
  grids.forEach((g) => {
    g.addEventListener('pointermove', onMove, { passive: true });
    g.addEventListener('pointerleave', hideCursor);
  });
  addEventListener('scroll', onScroll, { passive: true });
  document.documentElement.addEventListener('mouseleave', hideCursor);
  finePointer.addEventListener('change', syncFx);
  syncFx();
</script>

<style>
  .section-lead {
    text-align: center;
    color: var(--muted);
    margin: -0.5rem auto 2rem;
    max-width: 640px;
    width: 100%;
    text-wrap: balance;
    font-size: 1rem;
  }

  /* ── Category switcher ───────────────────────────────────────────── */
  .tabs {
    position: sticky;
    top: 84px;
    z-index: 20;
    display: flex;
    justify-content: center;
    padding: 10px 0 18px;
    transition: top 0.35s cubic-bezier(.2,.7,.2,1);
    pointer-events: none;
  }
  :global(.hdr-hidden) .tabs { top: 8px; }
  .tabs__track {
    position: relative;
    display: flex;
    gap: 4px;
    padding: 6px;
    border-radius: 999px;
    background: rgba(24, 24, 24, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
    pointer-events: auto;
    max-width: 100%;
  }
  .tabs__ind {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 999px;
    background: var(--brand-ink);
    box-shadow: 0 6px 22px rgba(208, 0, 127, 0.45);
    transition: transform 0.5s cubic-bezier(.2,.8,.2,1), width 0.5s cubic-bezier(.2,.8,.2,1), height 0.5s cubic-bezier(.2,.8,.2,1);
    will-change: transform, width;
  }
  .tabs button {
    position: relative;
    z-index: 1;
    font: inherit;
    font-weight: 700;
    border: 0;
    background: transparent;
    color: rgba(255, 255, 255, 0.78);
    border-radius: 999px;
    padding: 0.55em 1.25em;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    white-space: nowrap;
    transition: color 0.25s;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .tabs button:hover { color: #fff; }
  .tabs button[aria-selected='true'] { color: #fff; }
  .tabs button:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .tab__count {
    min-width: 1.9em;
    padding: 1px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    font-size: 0.78rem;
    font-weight: 700;
    text-align: center;
    transition: background 0.25s;
  }
  button[aria-selected='true'] .tab__count { background: rgba(0, 0, 0, 0.28); }

  /* ── Mosaic ──────────────────────────────────────────────────────── */
  [role='tabpanel'][hidden] { display: none; }
  [role='tabpanel'].is-entering { animation: panel-in 0.55s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes panel-in {
    from { opacity: 0; transform: scale(0.97) translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { [role='tabpanel'].is-entering { animation: none; } }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: clamp(150px, 15.5vw, 215px);
    grid-auto-flow: dense;
    gap: 14px;
  }
  .tile {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 20px;
    background: var(--surface);
    isolation: isolate;
    --rx: 0deg;
    --ry: 0deg;
    --fx: 50%;
    --fy: 30%;
    opacity: 0;
    transform: translateY(26px) scale(0.97);
    transition: opacity 0.7s cubic-bezier(.2,.7,.2,1), transform 0.7s cubic-bezier(.2,.7,.2,1), box-shadow 0.35s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .tile.is-more { display: none; }
  .tile.is-visible {
    opacity: 1;
    transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry)) translateZ(0);
    transition: opacity 0.7s cubic-bezier(.2,.7,.2,1), transform 0.25s ease-out, box-shadow 0.35s ease;
  }
  .tile--tall { grid-row: span 2; }
  .tile--wide { grid-column: span 2; grid-row: span 2; }
  .tile--std { grid-row: span 1; }
  @media (min-width: 981px) { .tile--bento { grid-column: span 2; } }

  .tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(var(--z, 1));
    transform-origin: var(--fx) var(--fy);
    transition: transform 0.9s cubic-bezier(.2,.7,.2,1), filter 0.4s;
  }
  .tile:hover :global(img),
  .tile:focus-visible :global(img) { transform: scale(calc(var(--z, 1) * 1.09)); }

  /* Cursor-tracking glow border.
     ::before = hairline glass edge, always on (static, free).
     ::after  = the glow: a radial gradient whose centre follows the pointer (--gx/--gy are set once per frame
     by the script), cut into a 2px ring with a mask, so only the border near the cursor lights up.
     Nothing animates on its own: no infinite animations, no work unless the pointer moves. */
  .tile::before,
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
  }
  .tile::before {
    z-index: 4;
    padding: 1px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.04) 45%, rgba(255, 255, 255, 0.1));
  }
  .tile::after {
    z-index: 5;
    padding: 2px;
    background: radial-gradient(190px circle at var(--gx, 50%) var(--gy, 50%), #fff 0%, #04a8f1 16%, #d0007f 42%, rgba(208, 0, 127, 0) 72%);
    opacity: 0;
    transition: opacity 0.35s;
  }
  .tile:hover::after, .tile:focus-visible::after { opacity: 1; }
  /* soft inner light under the pointer */
  .tile__glow {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: radial-gradient(360px circle at var(--gx, 50%) var(--gy, 50%), rgba(4, 168, 241, 0.18), rgba(208, 0, 127, 0.1) 40%, transparent 68%);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .tile:hover .tile__glow, .tile:focus-visible .tile__glow { opacity: 1; }

  .tile__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(rgba(0, 0, 0, 0.14), rgba(0, 0, 0, 0.14)),
      linear-gradient(180deg, transparent 45%, rgba(10, 10, 10, 0.72) 100%);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .tile:hover .tile__shade,
  .tile:focus-visible .tile__shade { opacity: 1; }
  .tile:hover,
  .tile:focus-visible {
    z-index: 2;
    box-shadow: 0 28px 60px rgba(0, 0, 0, 0.65), 0 0 46px -10px rgba(4, 168, 241, 0.3);
    outline: none;
  }
  .tile:focus-visible { box-shadow: 0 0 0 2px var(--blue), 0 28px 60px rgba(0, 0, 0, 0.65); }

  .tile__zoom {
    position: absolute;
    top: 12px;
    inset-inline-start: 12px;
    z-index: 2;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--blue);
    color: #00131c;
    opacity: 0;
    transform: scale(0.6) rotate(-30deg);
    transition: opacity 0.3s, transform 0.4s cubic-bezier(.2,.9,.3,1.4);
  }
  .tile:hover .tile__zoom,
  .tile:focus-visible .tile__zoom { opacity: 1; transform: none; }

  /* Liquid-glass info panel. Slides up on hover. 3D glass edge = bright top + left rim and a dim bottom/right,
     as if lit from the top-left. backdrop-filter only exists while the panel is shown, so 50 hidden panels
     don't each keep a blur layer alive. */
  .info {
    position: absolute;
    inset-inline: 10px;
    bottom: 10px;
    z-index: 6;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 12px 12px 14px;
    border-radius: 16px;
    color: #fff;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0) 38%),
      rgba(14, 14, 14, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-top-color: rgba(255, 255, 255, 0.42);
    border-left-color: rgba(255, 255, 255, 0.26);
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, 0.16), inset -1px -1px 0 rgba(0, 0, 0, 0.35), 0 12px 32px rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transform: translateY(calc(100% + 16px));
    transition: opacity 0.3s, transform 0.55s cubic-bezier(.2,.9,.25,1.05), visibility 0s 0.55s;
  }
  .tile:hover .info,
  .tile:focus-visible .info,
  .tile--video .info {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
    -webkit-backdrop-filter: blur(12px) saturate(165%);
    backdrop-filter: blur(12px) saturate(165%);
  }
  .info__text { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1; }
  .info__cat {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--blue);
  }
  .info__title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.3;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .info__go {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.22);
    transition: background 0.25s, transform 0.35s cubic-bezier(.2,.9,.3,1.3);
  }
  .tile:hover .info__go { background: var(--brand-ink); border-color: transparent; transform: translateX(-3px); }
  .tile--video .tile__shade { opacity: 1; }

  /* ── Custom trailing cursor (fine pointers only; the script toggles .is-on / .is-view) ── */
  .gcursor {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 80;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s;
    will-change: transform;
  }
  .gcursor.is-on { opacity: 1; }
  .gcursor__dot {
    position: absolute;
    left: -6px;
    top: -6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.4), 0 0 16px rgba(4, 168, 241, 0.75);
    transition: transform 0.3s cubic-bezier(.2,.8,.2,1);
  }
  .gcursor__view {
    position: absolute;
    left: -44px;
    top: -44px;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(208, 0, 127, 0.9);
    color: #fff;
    font-family: var(--font-ui);
