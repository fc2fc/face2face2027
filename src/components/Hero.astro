---
import { site } from '../lib/content';

const hero = site.hero;
const words = hero.h1.split(' ');
---

<section class="hero">
  <img class="hero__bg" src={hero.background} alt="" width="1920" height="1080" fetchpriority="high" />
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="container hero__content">
    <div class="hero__badge">📸 צלם ומעצב גרפי מוביל</div>
    <h1>
      {words.map((w: string, i: number) => <span style={`--i:${i}`}>{w}</span>)}
    </h1>
    <p class="hero__sub">{hero.h2}</p>
    <div class="hero__cta">
      <a class="btn btn--primary" href="/צרו-קשר">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 014.4 11.82 19.79 19.79 0 011.34 3.18 2 2 0 013.33 1h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L7.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
        לתיאום צילום
      </a>
      <a class="btn btn--outline" href="/עבודות">
        לעבודות שלנו
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
    <div class="hero__stats">
      <div class="stat"><strong>4,950+</strong><span>עבודות</span></div>
      <div class="stat__div" aria-hidden="true"></div>
      <div class="stat"><strong>10+</strong><span>שנות ניסיון</span></div>
      <div class="stat__div" aria-hidden="true"></div>
      <div class="stat"><strong>100%</strong><span>שביעות רצון</span></div>
    </div>
  </div>
  <a href="#services" class="hero__scroll" aria-label="גלול למטה">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(92vh, 860px);
    display: flex;
    align-items: center;
    color: #fff;
    overflow: hidden;
    background: var(--dark);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% center;
    transform: scale(1.06);
    animation: hero-zoom 8s ease-out forwards;
  }
  @keyframes hero-zoom {
    to { transform: scale(1); }
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(15,13,22,0.3) 0%, rgba(15,13,22,0.0) 40%, rgba(15,13,22,0.6) 100%),
      linear-gradient(270deg, rgba(15,13,22,0.88) 0%, rgba(15,13,22,0.55) 50%, rgba(15,13,22,0.05) 100%);
  }
  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: 80px;
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(225, 0, 133, 0.18);
    border: 1px solid rgba(225, 0, 133, 0.4);
    color: #fff;
    border-radius: 999px;
    padding: 6px 16px;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    margin-bottom: 1.2rem;
    opacity: 0;
    animation: fade-up 0.6s 0.2s ease forwards;
    backdrop-filter: blur(8px);
  }
  h1 {
    font-size: clamp(3.4rem, 11vw, 8.5rem);
    font-weight: 900;
    line-height: 0.93;
    letter-spacing: -0.025em;
    margin: 0 0 0.3em;
  }
  h1 span {
    display: block;
    opacity: 0;
    animation: fade-up 0.7s ease forwards;
    animation-delay: calc(0.35s + var(--i) * 0.12s);
  }
  h1 span:nth-child(2) {
    color: var(--brand);
    text-shadow: 0 0 60px rgba(225, 0, 133, 0.4);
  }
  .hero__sub {
    font-size: clamp(1.1rem, 2.2vw, 1.65rem);
    font-weight: 400;
    line-height: 1.5;
    margin: 0 0 1.8em;
    opacity: 0;
    animation: fade-up 0.7s 0.7s ease forwards;
    color: rgba(255,255,255,0.85);
    max-width: 520px;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    opacity: 0;
    animation: fade-up 0.7s 0.85s ease forwards;
  }
  .btn--primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.85em 1.8em;
    background: var(--brand);
    color: #fff;
    font-weight: 700;
    border-radius: 999px;
    text-decoration: none;
    font-size: 1rem;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 24px rgba(225,0,133,0.35);
  }
  .btn--primary:hover {
    background: var(--brand-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(225,0,133,0.45);
  }
  .btn--outline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.85em 1.8em;
    background: rgba(255,255,255,0.08);
    color: #fff;
    font-weight: 700;
    border-radius: 999px;
    text-decoration: none;
    font-size: 1rem;
    border: 1.5px solid rgba(255,255,255,0.35);
    backdrop-filter: blur(8px);
    transition: background 0.2s, transform 0.2s;
  }
  .btn--outline:hover {
    background: rgba(255,255,255,0.18);
    transform: translateY(-2px);
  }
  .hero__stats {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 3rem;
    opacity: 0;
    animation: fade-up 0.7s 1s ease forwards;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .stat strong {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--brand);
  }
  .stat span {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.65);
    font-weight: 500;
  }
  .stat__div {
    width: 1px;
    height: 36px;
    background: rgba(255,255,255,0.2);
  }
  .hero__scroll {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    animation: fade-up 0.6s 1.3s ease forwards;
  }
  .hero__scroll span {
    width: 24px;
    height: 36px;
    border: 2px solid rgba(255,255,255,0.4);
    border-radius: 12px;
    position: relative;
  }
  .hero__scroll span::after {
    content: '';
    position: absolute;
    top: 5px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 8px;
    border-radius: 4px;
    background: rgba(255,255,255,0.7);
    animation: scroll-dot 1.8s infinite;
  }
  @keyframes scroll-dot {
    0%, 100% { transform: translateX(-50%) translateY(0); opacity: 1; }
    80% { transform: translateX(-50%) translateY(10px); opacity: 0; }
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (max-width: 640px) {
    .hero__stats { gap: 16px; }
    .stat strong { font-size: 1.2rem; }
    .hero__scroll { display: none; }
  }
</style>
