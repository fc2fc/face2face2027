---
import Icon from './Icon.astro';
import { Picture, getImage } from 'astro:assets';
import { site, asset } from '../lib/content';
import { HERO_POSTER } from '../lib/hero';

const hero = site.hero;
// The poster image is the LCP element: serve it responsive (AVIF/WebP) and first.
// Never lazy: it is above the fold and preloaded from <head> (see HeroPreload.astro).
const poster = asset(HERO_POSTER.src);
const videoPoster = await getImage({ src: poster, width: 828, format: 'webp', quality: 60 });
---

<section class="hero">
  <div class="hero__stage">
  <Picture
    class="hero__bg hero__bg--poster"
    src={poster}
    alt=""
    widths={[...HERO_POSTER.widths]}
    sizes={HERO_POSTER.sizes}
    formats={['avif']}
    fallbackFormat="webp"
    loading="eager"
    fetchpriority="high"
  />
  <video
    class="hero__bg hero__bg--video"
    id="hero-video"
    data-src="/assets/hero-scroll.mp4"
    data-src-mobile="/assets/hero-scroll-m.mp4"
    poster={videoPoster.src}
    width="1920"
    height="1082"
    muted
    playsinline
    preload="none"
    disablepictureinpicture
    aria-hidden="true"
    tabindex="-1"
  ></video>
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__stage hero__stage--tag">
    <!-- Name tag pinned to the shoulder; coordinates are in video-frame space (1918x1080) so it moves with the picture -->
    <div class="hero__tag" aria-hidden="true">
      <svg viewBox="0 0 1918 1080" preserveAspectRatio="none">
        <polyline class="tag__line" points="1145,513 1053,130 955,130" pathLength="1" />
        <g class="tag__dot tag__dot--a"><circle cx="1145" cy="513" r="13" /><circle class="tag__core" cx="1145" cy="513" r="4.5" /></g>
        <g class="tag__dot tag__dot--b"><circle cx="955" cy="130" r="13" /><circle class="tag__core" cx="955" cy="130" r="4.5" /></g>
      </svg>
      <span class="tag__name">נגה מלסה</span>
    </div>
  </div>
  <div class="container hero__content">
    <div class="hero__copy">
    <h1>
      <span class="t t1">צילום.</span>
      <span class="t t2">עיצוב</span>
      <span class="t t3">נוכחות!</span>
    </h1>
    <p class="hero__sub">{hero.h2}</p>
    </div>
    <div class="hero__cta">
      <a class="btn btn--primary" href="/צרו-קשר">
        <Icon name="phone-call" size={18} />
        לתיאום צילום
      </a>
      <a class="btn btn--outline" href="/עבודות">
        לעבודות שלנו
        <Icon name="arrow-left" size={18} />
      </a>
    </div>
    <div class="hero__stats">
      <div class="stat"><strong class="stat__num" data-to="4950" data-suffix="+">4,950+</strong><span>עבודות</span></div>
      <div class="stat__div" aria-hidden="true"></div>
      <div class="stat"><strong class="stat__num" data-to="16" data-suffix="+">16+</strong><span>שנות ניסיון</span></div>
      <div class="stat__div" aria-hidden="true"></div>
      <div class="stat"><strong class="stat__num" data-to="100" data-suffix="%">100%</strong><span>שביעות רצון</span></div>
    </div>
  </div>
  <a href="#services" class="hero__scroll" aria-label="גלול למטה">
    <span></span>
  </a>
</section>

<style>
  @font-face { font-family: 'Fb Melatef'; src: url('/fonts/fb-melatef-regular.woff2') format('woff2'); font-weight: 400; font-display: swap; }
  .hero {
    position: relative;
    container-type: size;
    height: calc(clamp(640px, 92vh, 860px) + var(--hdr-h));
    min-height: min(92vh, 860px);
    margin-top: calc(var(--hdr-h) * -1);
    padding-top: var(--hdr-h);
    display: flex;
    align-items: center;
    color: #fff;
    overflow: hidden;
    background: var(--dark);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% center;
    will-change: opacity, transform;
  }
  /* Stage = a 16:9 frame that covers the hero, scaled down and shifted left so the RTL text column stays clear.
     Video, poster and name tag live in it, so they move together. */
  .hero__stage {
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100cqw, 177.78cqh);
    aspect-ratio: 16 / 9;
    transform: translate(calc(-50% - 10cqw), -50%) scale(0.84);
    transform-origin: center;
  }
  .hero__stage :global(.hero__bg) {
    inset: 0;
    object-position: center;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 14%, #000 86%, transparent 100%), linear-gradient(to right, transparent 0, #000 12%, #000 88%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to bottom, transparent 0, #000 14%, #000 86%, transparent 100%), linear-gradient(to right, transparent 0, #000 12%, #000 88%, transparent 100%);
    mask-composite: intersect;
  }
  .hero__bg--video { opacity: 0; transition: opacity 0.4s; }
  .hero__bg--video.is-ready { opacity: 1; }

  /* Name tag: dot on the shoulder -> line draws up -> second dot -> name reveals (starts 3s after load) */
  .hero__tag { position: absolute; inset: 0; pointer-events: none; opacity: var(--tag-o, 1); }
  .hero__tag svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .tag__line {
    fill: none;
    stroke: #fff;
    stroke-width: 2.4;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .tag__dot { transform-box: fill-box; transform-origin: center; transform: scale(0); }
  .tag__dot circle { fill: rgba(255,255,255,0.12); stroke: #fff; stroke-width: 2.4; }
  .tag__dot .tag__core { fill: #fff; stroke: none; }
  .tag__name {
    position: absolute;
    right: calc(100% - 48.4%);
    top: 12%;
    transform: translateY(-50%);
    font-family: var(--font);
    font-weight: 700;
    font-size: clamp(14px, 1.15cqw, 22px);
    color: #fff;
    white-space: nowrap;
    clip-path: inset(0 0 0 100%);
  }
  /* .tag-on is toggled by script: added 3s after the page loads / after returning to the top, removed when scrolling away */
  .hero.tag-on .tag__dot--a { animation: tag-pop 0.5s cubic-bezier(.3,1.6,.5,1) forwards; }
  .hero.tag-on .tag__line { animation: tag-draw 1.1s 0.4s cubic-bezier(.65,0,.35,1) forwards; }
  .hero.tag-on .tag__dot--b { animation: tag-pop 0.5s 1.4s cubic-bezier(.3,1.6,.5,1) forwards; }
  .hero.tag-on .tag__name { animation: tag-name 0.8s 1.7s cubic-bezier(.2,.7,.2,1) forwards; }
  @keyframes tag-draw { to { stroke-dashoffset: 0; } }
  @keyframes tag-pop { to { transform: scale(1); } }
  @keyframes tag-name { to { clip-path: inset(0 0 0 0); } }
  @media (prefers-reduced-motion: reduce) {
    .hero .tag__line, .hero.tag-on .tag__line { animation: none; stroke-dashoffset: 0; }
    .hero .tag__dot, .hero.tag-on .tag__dot { animation: none; transform: none; }
    .hero .tag__name, .hero.tag-on .tag__name { animation: none; clip-path: none; }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(20,20,20,0.3) 0%, rgba(20,20,20,0.0) 40%, rgba(20,20,20,0.6) 100%),
      linear-gradient(270deg, rgba(20,20,20,0.88) 0%, rgba(20,20,20,0.55) 50%, rgba(20,20,20,0.05) 100%);
  }
  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px 80px;
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(208,0,127, 0.18);
    border: 1px solid rgba(208,0,127, 0.4);
    color: #fff;
    border-radius: 999px;
    padding: 6px 16px;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    margin-bottom: 1.2rem;
    opacity: 0;
    animation: fade-up 0.6s 0.2s ease forwards;
    backdrop-filter: blur(8px);
  }
  h1 {
    position: relative;
    font-size: clamp(3.4rem, calc((min(100vw, 1248px) - 48px) * 0.175), 210px);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
    word-spacing: -0.05em;
    margin: 0;
    width: fit-content;
  }
  .t { display: block; }
  .t1, .t3 { color: var(--brand); opacity: 0; animation: fade-up 0.7s 0.2s ease forwards; }
  .t1 { translate: 0 0.11em; } /* sits lower so the lam of "צילום" touches the top of the handwritten word */
  .t3 { animation-delay: 0.45s; }
  /* handwritten word sits between the two pink lines, overlapping both, revealed right-to-left like a pen stroke */
  .t2 {
    position: absolute;
    inset-inline: 0;
    top: 43%;
    z-index: 1;
    font-family: 'Fb Melatef', var(--font);
    font-weight: 400;
    font-size: 2.65em;
    line-height: 1;
    letter-spacing: 0;
    text-align: center;
    color: #fff;
    pointer-events: none;
    transform: translateY(-50%) rotate(-4deg);
    clip-path: inset(0 0 0 100%);
    animation: pen 1s 0.9s cubic-bezier(.5,0,.2,1) forwards;
  }
  @keyframes pen { to { clip-path: inset(-20% -10% -20% -10%); } }
  .hero__sub {
    font-size: clamp(1.5rem, calc((min(100vw, 1248px) - 48px) * 0.053), 64px);
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: -0.2em 0 0.95em;
    opacity: 0;
    animation: fade-up 0.7s 0.7s ease forwards;
    color: #fff;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    opacity: 0;
    animation: fade-up 0.7s 0.85s ease forwards;
  }
  .btn--primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.85em 1.8em;
    background: var(--brand-ink);
    color: #fff;
    font-weight: 700;
    border-radius: 999px;
    text-decoration: none;
    font-size: 1rem;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 24px rgba(208,0,127,0.35);
  }
  .btn--primary:hover {
    background: var(--brand-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(208,0,127,0.45);
  }
  .btn--outline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.85em 1.8em;
    background: rgba(255,255,255,0.08);
    color: #fff;
    font-weight: 700;
    border-radius: 999px;
    text-decoration: none;
    font-size: 1rem;
    border: 1.5px solid rgba(255,255,255,0.35);
    backdrop-filter: blur(8px);
    transition: background 0.2s, transform 0.2s;
  }
  .btn--outline:hover {
    background: rgba(255,255,255,0.18);
    transform: translateY(-2px);
  }
  .hero__stats {
    position: absolute;
    left: 24px;
    bottom: 36px;
    display: flex;
    align-items: center;
    gap: 24px;
    opacity: 0;
    animation: fade-up 0.7s 1s ease forwards;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .stat { animation: stat-float 5.5s ease-in-out infinite alternate; }
  .stat:nth-child(3) { animation-delay: -1.8s; }
  .stat:nth-child(5) { animation-delay: -3.6s; }
  @keyframes stat-float { from { translate: 0 0; } to { translate: 0 -4px; } }
  .stat strong {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--brand);
    font-variant-numeric: tabular-nums;
    transform-origin: right center;
    transform: scale(var(--grow, 1));
    display: inline-block;
  }
  @media (prefers-reduced-motion: reduce) { .stat { animation: none; } }
  .stat span {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.65);
    font-weight: 500;
  }
  .stat:nth-child(3) strong { color: var(--blue); }
  .stat:nth-child(5) strong { color: var(--yellow); }
  .stat__div {
    width: 1px;
    height: 36px;
    background: rgba(255,255,255,0.2);
  }
  .hero__scroll {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    animation: fade-up 0.6s 1.3s ease forwards;
  }
  .hero__scroll span {
    width: 24px;
    height: 36px;
    border: 2px solid rgba(255,255,255,0.4);
    border-radius: 12px;
    position: relative;
  }
  .hero__scroll span::after {
    content: '';
    position: absolute;
    top: 5px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 8px;
    border-radius: 4px;
    background: rgba(255,255,255,0.7);
    animation: scroll-dot 1.8s infinite;
  }
  @keyframes scroll-dot {
    0%, 100% { transform: translateX(-50%) translateY(0); opacity: 1; }
    80% { transform: translateX(-50%) translateY(10px); opacity: 0; }
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  /* ── Mobile (≤768px) ───────────────────────────────────────────────────────────────────────
     Layout from the approved mobile design: header pill, wide image, headline + script word on the
     right, CTAs floating top-left, stats row bottom-right. It is drawn at 385px wide and scaled with
     --k (1 unit = 1px at 385px, capped at 520px) so it keeps its proportions on any phone.
     Desktop is untouched: everything here is inside this media query. */
  @media (max-width: 768px) {
    .hero {
      --k: calc(min(100vw, 520px) / 385);
      container-type: normal;
      display: block;
      height: calc(var(--k) * 304);
      min-height: 0;
    }
    .hero__stage { display: contents; }
    .hero__tag { display: none; }
    .hero__scroll { display: none; }

    /* Poster + video: wide 3:2 frame under the header, object-fit: cover, soft top/bottom edges */
    .hero__stage :global(.hero__bg) {
      inset: calc(var(--k) * 44) 0 auto 0;
      height: calc(var(--k) * 262);
      object-fit: cover;
      object-position: 100% 30%;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 9%, #000 80%, transparent 100%);
      mask-image: linear-gradient(to bottom, transparent 0, #000 9%, #000 80%, transparent 100%);
      -webkit-mask-composite: source-over;
      mask-composite: add;
    }
    .hero__overlay {
      background:
        linear-gradient(180deg, rgba(18,18,18,0.15) 0%, rgba(18,18,18,0) 35%, rgba(18,18,18,0.55) 100%),
        linear-gradient(270deg, rgba(18,18,18,0.5) 0%, rgba(18,18,18,0.12) 55%, rgba(18,18,18,0) 100%);
    }

    /* Everything on top of the image is positioned in --k units, RTL: "right" is the start side */
    .hero__content { position: absolute; inset: 0; width: auto; max-width: none; margin: 0; padding: 0; }
    .hero__copy { position: absolute; right: calc(var(--k) * 25); top: calc(var(--k) * 69); }
    h1 { font-size: calc(var(--k) * 75.6); line-height: 1; letter-spacing: -0.05em; }
    .t1 { translate: 0 0; }
    /* Script word: large, ~12° diagonal across both pink lines, nudged toward the start side */
    .t2 { font-size: 2em; letter-spacing: 0.05em; top: 43%; -webkit-text-stroke: calc(var(--k) * 0.5) #fff; transform: translate(calc(var(--k) * 17), -50%) rotate(-12deg); }
    .hero__sub {
      font-size: calc(var(--k) * 21.2);
      margin: calc(var(--k) * -9) 0 0;
      line-height: 1.15;
    }

    /* CTAs: stacked, floating on the left (end side). Text/tap sizes keep a readable floor on small phones. */
    .hero__cta {
      position: absolute;
      left: calc(var(--k) * 17);
      top: calc(var(--k) * 84);
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: flex-start;
      gap: calc(var(--k) * 6);
    }
    /* Small pill buttons as in the design. Floors keep them usable: 26px tall (≥ WCAG 2.5.8's 24px) and ≥10.5px text. */
    .btn--primary, .btn--outline {
      width: auto;
      min-height: max(26px, calc(var(--k) * 26));
      padding: 0 max(9px, calc(var(--k) * 9));
      font-size: max(10.5px, calc(var(--k) * 10.5));
      gap: max(4px, calc(var(--k) * 4));
      box-shadow: none;
    }
    .btn--primary :global(svg), .btn--outline :global(svg) { width: max(12px, calc(var(--k) * 12)); height: max(12px, calc(var(--k) * 12)); }

    /* Stats: one row at the bottom-right, three columns separated by thin dividers */
    .hero__stats {
      position: absolute;
      left: auto;
      bottom: auto;
      right: calc(var(--k) * 48);
      top: calc(var(--k) * 250);
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: center;
      gap: calc(var(--k) * 9);
      margin: 0;
    }
    .stat { align-items: flex-start; gap: 1px; animation-duration: 6s; }
    .stat strong { font-size: max(12.5px, calc(var(--k) * 12.5)); }
    .stat span { font-size: max(10px, calc(var(--k) * 10)); }
    .stat__div { display: block; width: 1px; height: calc(var(--k) * 20); background: rgba(255,255,255,0.28); }
  }
</style>

<script>
  // Scroll-linked video: top of page = frame 0 (eye contact); scrolling down scrubs to the last frame
  // (looking at the screen); scrolling up rewinds. Video is never auto-played.
  const heroEl = document.querySelector<HTMLElement>('.hero');
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;
  if (heroEl) {
    // Name tag: plays 3s after load; fades while scrolling away, resets, and plays again 3s after returning to the top.
    let tagTimer = 0;
    const armTag = () => {
      if (tagTimer || heroEl.classList.contains('tag-on')) return;
      tagTimer = window.setTimeout(() => {
        tagTimer = 0;
        if (window.scrollY < heroEl.offsetHeight * 0.05) heroEl.classList.add('tag-on');
      }, 3000);
    };
    const onTagScroll = () => {
      const h = heroEl.offsetHeight;
      heroEl.style.setProperty('--tag-o', String(Math.max(0, 1 - window.scrollY / (h * 0.12))));
      if (window.scrollY > h * 0.12) {
        heroEl.classList.remove('tag-on'); // fully faded: reset to the hidden state
        window.clearTimeout(tagTimer); tagTimer = 0;
      } else if (window.scrollY < h * 0.03) armTag();
    };
    window.addEventListener('scroll', onTagScroll, { passive: true });
    onTagScroll();
    armTag();
  }
  if (heroEl && video) {
    const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const small = matchMedia('(max-width: 768px)').matches;

    let duration = 0;
    let cur = 0; // smoothed progress 0..1
    let target = 0; // raw progress 0..1
    let raf = 0;
    const SPAN = 0.6; // fraction of the hero height over which the video plays

    const calc = () => clamp(window.scrollY / (heroEl.offsetHeight * SPAN), 0, 1);
    const render = () => {
      cur += (target - cur) * 0.18;
      if (Math.abs(target - cur) < 0.0015) cur = target;
      const t = cur * duration;
      // only seek when the previous seek finished and the change is at least ~1 frame
      if (!video.seeking && Math.abs(video.currentTime - t) > 1 / 60) video.currentTime = t;
      raf = cur === target && !video.seeking ? 0 : requestAnimationFrame(render);
    };
    const onScroll = () => {
      target = calc();
      if (!raf) raf = requestAnimationFrame(render);
    };

    const ready = () => {
      duration = Math.max(0, video.duration - 0.04); // stay clear of the very last frame
      video.pause();
      video.classList.add('is-ready');
      if (reduced) { video.currentTime = 0; return; }
      target = cur = calc();
      video.currentTime = cur * duration;
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
    };
    video.addEventListener('loadeddata', () => {
      // iOS Safari only decodes frames for seeking after a muted play() has been allowed once
      const p = video.play();
      if (p && p.then) p.then(ready, ready); else ready();
    }, { once: true });
    video.addEventListener('error', () => video.classList.remove('is-ready')); // poster image stays visible

    // The video (2.6–4.9MB) must not compete with the poster image for bandwidth: start it only
    // after the page has loaded, and skip it entirely on data-saver connections.
    const conn = (navigator as any).connection;
    const start = () => {
      video.src = (small ? video.dataset.srcMobile : video.dataset.src) as string;
      video.preload = 'auto';
      video.load();
    };
    const whenIdle = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 2000 }) : setTimeout(start, 200));
    if (!conn?.saveData && !/2g/.test(conn?.effectiveType ?? '')) {
      if (document.readyState === 'complete') whenIdle();
      else window.addEventListener('load', whenIdle, { once: true });
    }
  }

  // Stats: count up slowly while growing a touch (reduced motion: final values stay as-is)
  const nums = document.querySelectorAll<HTMLElement>('.stat__num');
  if (nums.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const DUR = 3600;
    const fmt = new Intl.NumberFormat('en-US');
    nums.forEach((el) => {
      const to = Number(el.dataset.to);
      const suffix = el.dataset.suffix || '';
      el.style.minWidth = `${el.textContent!.length * 0.62}em`; // reserve final width: no layout jitter while counting
      el.textContent = `0${suffix}`;
      el.style.setProperty('--grow', '0.9');
      const t0 = performance.now() + 1100; // starts as the stats fade in
      const step = (now: number) => {
        const p = Math.min(1, Math.max(0, (now - t0) / DUR));
        const e = 1 - Math.pow(1 - p, 3);
        el.textContent = `${fmt.format(Math.round(to * e))}${suffix}`;
        el.style.setProperty('--grow', String(0.9 + 0.16 * e));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }
</script>
