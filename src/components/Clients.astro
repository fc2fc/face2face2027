---
import { site, clientName } from '../lib/content';

interface Props {
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const clients = site.clients as { logo: string; link: string | null; alt?: string }[];
---

<section class="section" id="clients">
  <div class="container">
    <Heading class="section-title">בין לקוחותינו</Heading>
    <p class="section-lead">ארגונים, משרדי ממשלה ועסקים שבחרו לעמוד מול המצלמה שלנו.</p>
    <ul class="wall">
      {
        clients.map((c, i) => {
          const name = c.alt || clientName(c.link);
          const img = <img src={c.logo} alt={name} width="120" height="120" loading="lazy" />;
          return (
            <li class="tile reveal" style={`--d:${(i % 6) * 70}ms`}>
              {c.link ? (
                <a href={c.link} target="_blank" rel="noopener" title={name} aria-label={name}>
                  {img}
                </a>
              ) : (
                img
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .wall {
    list-style: none;
    margin: 2.2rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }
  .tile {
    width: calc((100% - 96px) / 7);
    min-width: 120px;
    aspect-ratio: 1;
    border-radius: 18px;
    background: var(--surface);
    display: grid;
    place-items: center;
    padding: 18px;
    transition-delay: var(--d);
    box-shadow: 0 0 0 1px var(--line);
    overflow: hidden;
  }
  .tile:hover {
    transform: translateY(-5px);
    box-shadow: 0 0 0 2px var(--brand), 0 18px 36px rgba(0, 0, 0, 0.5);
  }
  .tile a { display: contents; }
  .tile img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* logos are opaque on white: flatten to one uniform light tone on the dark tile */
    filter: grayscale(1) brightness(0.7) contrast(4.2) invert(1);
    mix-blend-mode: screen;
    opacity: 1;
    transition: transform 0.35s cubic-bezier(.2,.7,.2,1), opacity 0.3s;
  }
  .tile:hover img { transform: scale(1.07); opacity: 1; }
  @media (max-width: 640px) {
    .wall { gap: 10px; }
    .tile { width: calc((100% - 20px) / 3); min-width: 0; padding: 10px; border-radius: 14px; }
  }
  @media (max-width: 380px) {
    .tile { width: calc((100% - 10px) / 2); }
  }
</style>
