---
import { site, clientName } from '../lib/content';

interface Props {
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const clients = site.clients as { logo: string; link: string | null; alt?: string; name?: string }[];
// Double the list for infinite scroll
const doubled = [...clients, ...clients];
---

<section class="section section--soft" id="clients">
  <div class="container">
    <Heading class="section-title">בין לקוחותינו</Heading>
  </div>
  <div class="slider-wrap" aria-label="לוגואי לקוחות">
    <div class="slider" data-slider>
      <ul class="track" data-track>
        {
          doubled.map((c) => {
            const name = (c as any).alt || clientName(c.link);
            const img = <img src={c.logo} alt={name} width="120" height="120" loading="lazy" />;
            return (
              <li class="logo-card" aria-hidden={undefined}>
                {c.link ? (
                  <a href={c.link} target="_blank" rel="noopener" title={name}>
                    {img}
                  </a>
                ) : (
                  img
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

<script>
  // Vanilla JS infinite marquee – no framer-motion needed
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((slider) => {
    if (reducedMotion) return; // skip animation, logos still visible
    const track = slider.querySelector<HTMLElement>('[data-track]')!;
    if (!track) return;

    const SPEED = 0.4; // px per frame
    let pos = 0;
    let paused = false;
    let raf = 0;

    // Wait for layout to measure half-width (one set of logos)
    function getHalf() {
      return track.scrollWidth / 2;
    }

    function tick() {
      if (!paused) {
        pos -= SPEED;
        const half = getHalf();
        if (Math.abs(pos) >= half) {
          pos = 0; // seamless loop
        }
        track.style.transform = `translateX(${pos}px)`;
      }
      raf = requestAnimationFrame(tick);
    }

    slider.addEventListener('mouseenter', () => { paused = true; });
    slider.addEventListener('mouseleave', () => { paused = false; });
    slider.addEventListener('touchstart', () => { paused = true; }, { passive: true });
    slider.addEventListener('touchend',   () => { paused = false; }, { passive: true });

    raf = requestAnimationFrame(tick);
  });
</script>

<style>
  .slider-wrap {
    overflow: hidden;
    position: relative;
    /* Fade edges */
    mask-image: linear-gradient(to right, transparent 0%, #000 8%, #000 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 8%, #000 92%, transparent 100%);
    padding: 1rem 0;
  }
  .slider {
    overflow: visible;
    cursor: default;
  }
  .track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 20px;
    width: max-content;
    will-change: transform;
  }
  .logo-card {
    flex: none;
    width: 130px;
    height: 90px;
    background: #fff;
    border-radius: 14px;
    display: grid;
    place-items: center;
    padding: 14px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    transition: box-shadow 0.25s, transform 0.25s;
  }
  .logo-card:hover {
    box-shadow: 0 6px 24px rgba(236,0,140,0.12);
    transform: translateY(-3px);
  }
  .logo-card img,
  .logo-card a img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.75;
    transition: filter 0.25s, opacity 0.25s;
    display: block;
  }
  .logo-card:hover img,
  .logo-card:hover a img {
    filter: none;
    opacity: 1;
  }
  .logo-card a {
    display: contents;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  @media (max-width: 640px) {
    .logo-card {
      width: 110px;
      height: 76px;
      padding: 10px;
      border-radius: 12px;
    }
    .track { gap: 14px; }
  }
  @media (max-width: 380px) {
    .logo-card {
      width: 90px;
      height: 64px;
      padding: 8px;
    }
    .track { gap: 10px; }
  }
</style>
