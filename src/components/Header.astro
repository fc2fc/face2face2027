---
import { site } from '../lib/content';

interface Props {
  current: string;
}
const { current } = Astro.props;
const nav = site.navigation as { label: string; old_url: string }[];
const isActive = (url: string) => (url === '/' ? current === '/' : current === url || current.startsWith(url + '/'));
---

<header class="header" id="header">
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label="Face2Face – דף הבית">
      <img src={site.logo} srcset={`${site.logo} 1x, ${site.logo_2x} 2x`} alt="Face2Face" width="170" height="40" />
    </a>
    <button class="header__toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">תפריט</span>
      <span class="bars" aria-hidden="true"></span>
    </button>
    <nav id="site-nav" class="header__nav" aria-label="ניווט ראשי">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.old_url}
                class:list={[isActive(item.old_url) && 'is-active']}
                aria-current={isActive(item.old_url) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="nav__cta">
          <a href="/צרו-קשר" class="btn-cta">צרו קשר</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('header')!;
  const toggle = header.querySelector<HTMLButtonElement>('.header__toggle')!;
  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    header.classList.toggle('is-open', !open);
  });
  // סגירת תפריט בלחיצה על לינק
  header.querySelectorAll('nav a').forEach(a => a.addEventListener('click', () => {
    toggle.setAttribute('aria-expanded', 'false');
    header.classList.remove('is-open');
  }));
  let lastY = window.scrollY;
  const onScroll = () => {
    const y = window.scrollY;
    header.classList.toggle('is-scrolled', y > 20);
    const menuOpen = header.classList.contains('is-open');
    if (!menuOpen && y > 400 && y > lastY + 6) header.classList.add('is-hidden');
    else if (y < lastY - 6 || y <= 400 || menuOpen) header.classList.remove('is-hidden');
    lastY = y;
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    border-bottom: 1px solid rgba(231, 229, 236, 0.6);
    transition: box-shadow 0.3s, background 0.3s, transform 0.35s cubic-bezier(.2,.7,.2,1);
  }
  .header.is-hidden { transform: translateY(-100%); }
  .header.is-scrolled {
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 4px 24px rgba(15, 13, 22, 0.08);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 70px;
    gap: 20px;
  }
  .header__logo img {
    width: 150px;
    height: auto;
    transition: opacity 0.2s;
  }
  .header__logo:hover img { opacity: 0.85; }
  .header__nav ul {
    display: flex;
    align-items: center;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header__nav a:not(.btn-cta) {
    display: block;
    padding: 7px 14px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 999px;
    color: var(--ink);
    transition: color 0.2s, background 0.2s;
    position: relative;
  }
  .header__nav a:not(.btn-cta):hover {
    color: var(--brand);
    background: rgba(225, 0, 133, 0.06);
  }
  .header__nav a.is-active {
    color: var(--brand);
    background: rgba(225, 0, 133, 0.08);
  }
  .nav__cta {
    margin-inline-start: 8px;
  }
  .btn-cta {
    display: inline-block;
    padding: 8px 20px;
    background: var(--brand);
    color: #fff !important;
    font-weight: 700;
    font-size: 0.9rem;
    border-radius: 999px;
    text-decoration: none !important;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 3px 14px rgba(225, 0, 133, 0.3);
  }
  .btn-cta:hover {
    background: var(--brand-dark);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(225, 0, 133, 0.4);
  }
  .header__toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    cursor: pointer;
    position: relative;
    border-radius: 10px;
    transition: background 0.2s;
  }
  .header__toggle:hover { background: rgba(225,0,133,0.06); }
  .bars,
  .bars::before,
  .bars::after {
    position: absolute;
    left: 11px;
    width: 22px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.25s, opacity 0.25s;
  }
  .bars { top: 21px; }
  .bars::before, .bars::after { content: ''; left: 0; }
  .bars::before { top: -7px; }
  .bars::after { top: 7px; }
  .is-open .bars { background: transparent; }
  .is-open .bars::before { transform: translateY(7px) rotate(45deg); }
  .is-open .bars::after { transform: translateY(-7px) rotate(-45deg); }
  @media (max-width: 860px) {
    .header__toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .header__nav {
      position: absolute;
      top: calc(100% + 1px);
      inset-inline: 0;
      background: rgba(255,255,255,0.98);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
      display: none;
      border-radius: 0 0 20px 20px;
      z-index: 49;
    }
    .is-open .header__nav { display: block; }
    .header__nav ul {
      flex-direction: column;
      align-items: stretch;
      padding: 12px 16px 24px;
      gap: 4px;
    }
    .header__nav a:not(.btn-cta) {
      padding: 14px 16px;
      border-radius: 12px;
      font-size: 1rem;
      min-height: 48px;
      display: flex;
      align-items: center;
    }
    .nav__cta { margin-inline-start: 0; margin-top: 8px; }
    .btn-cta {
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 14px;
      min-height: 52px;
      font-size: 1rem;
      border-radius: 14px;
    }
  }
  @media (max-width: 480px) {
    .header__inner { min-height: 60px; }
    .header__logo img { width: 130px; }
  }
</style>
