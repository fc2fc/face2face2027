---
import { Picture } from 'astro:assets';
import { site, asset } from '../lib/content';
import LeadForm from './LeadForm.astro';
import Icon from './Icon.astro';

const popup = site.popup;
---

<dialog class="popup" id="lead-popup" aria-labelledby="popup-title">
  <button class="popup__close" type="button" aria-label="סגירה" data-close>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path></svg>
  </button>

  <div class="popup__visual" aria-hidden="true">
    <Picture
      src={asset(popup.image)}
      alt=""
      widths={[420, 787]}
      sizes="(max-width: 640px) 100vw, 420px"
      formats={['avif']}
      fallbackFormat="webp"
      loading="lazy"
      class="popup__img"
    />
    <span class="vf vf--tl"></span><span class="vf vf--tr"></span><span class="vf vf--bl"></span><span class="vf vf--br"></span>
    <span class="focus"></span>
    <div class="who">
      <strong>נגה מלסה</strong>
      <span>צילום, וידאו ועיצוב גרפי</span>
    </div>
  </div>

  <div class="popup__body">
    <h2 id="popup-title" tabindex="-1" autofocus>{popup.title}</h2>
    <p class="popup__sub">{popup.subtitle}</p>
    <LeadForm fields={popup.fields} submitLabel={popup.submit_label} formName="popup" />
    <a class="popup__wa" href={site.contact.whatsapp} target="_blank" rel="noopener">
      <Icon name="whatsapp-logo" size={20} />
      <span>מעדיפים וואטסאפ? כתבו לנו ישר</span>
    </a>
  </div>
</dialog>

<script>
  // Opens on every visit and every page load (no once-per-N-days limit), as soon as the visitor scrolls to the
  // "אודות" (About) section. Pages without an About section fall back to 70% scroll depth. Never on the contact
  // page (it already has the form) and never over another open dialog (e.g. the gallery lightbox).
  const dialog = document.getElementById('lead-popup') as HTMLDialogElement;
  const onContactPage = decodeURI(location.pathname).replace(/\.html$/, '').startsWith('/contact');
  const img = dialog.querySelector('img');
  const about = document.getElementById('about');
  const preload = () => img?.setAttribute('loading', 'eager'); // fetch the photo before the popup opens, so it never appears empty

  if (!onContactPage) {
    let done = false;
    let inView = false;
    let scrolled = window.scrollY > 80; // never pop up on arrival, only after the visitor has actually scrolled
    const tryOpen = () => {
      if (window.scrollY > 80) scrolled = true;
      if (done || !inView || !scrolled) return;
      if (document.querySelector('dialog[open]')) return; // retried on the next scroll
      done = true;
      dialog.showModal();
    };
    if (about && 'IntersectionObserver' in window) {
      new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) preload(); }), { rootMargin: '0px 0px 150% 0px' }).observe(about);
      new IntersectionObserver((es) => es.forEach((e) => { inView = e.isIntersecting; tryOpen(); }), { threshold: 0.2 }).observe(about);
      window.addEventListener('scroll', tryOpen, { passive: true });
    } else {
      const onScroll = () => {
        const doc = document.documentElement;
        const seen = (window.scrollY + window.innerHeight) / doc.scrollHeight;
        if (seen > 0.4) preload();
        inView = doc.scrollHeight > window.innerHeight && seen >= 0.7;
        tryOpen();
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }
  // Closing plays a short exit animation (skipped for reduced motion); Esc, the × button and a backdrop click all use it.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const closeSoft = () => {
    if (!dialog.open || dialog.classList.contains('is-closing')) return;
    if (reduce) return dialog.close();
    dialog.classList.add('is-closing');
    setTimeout(() => {
      dialog.classList.remove('is-closing');
      dialog.close();
    }, 220);
  };
  dialog.querySelector('[data-close]')!.addEventListener('click', closeSoft);
  dialog.addEventListener('cancel', (e) => {
    e.preventDefault();
    closeSoft();
  });
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) closeSoft();
  });
</script>

<style>
  @property --pa { syntax: '<angle>'; inherits: false; initial-value: 0deg; }

  .popup {
    --pink: #d0007f;
    --cyan: #04a8f1;
    --sun: #f7e71a;
    direction: rtl;
    width: min(900px, 100% - 32px);
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    border-radius: 28px;
    overflow: hidden auto;
    color: var(--ink);
    background:
      radial-gradient(80% 60% at 100% 0%, rgba(4, 168, 241, 0.13), transparent 60%),
      radial-gradient(70% 60% at 100% 100%, rgba(208, 0, 127, 0.16), transparent 62%),
      #121214;
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .popup[open] {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    grid-template-areas: 'body visual';
    animation: pop-in 0.62s cubic-bezier(.2, .9, .25, 1) both;
  }
  .popup.is-closing { animation: pop-out 0.22s ease-in both; }
  .popup[open]::backdrop {
    background: radial-gradient(60% 60% at 50% 50%, rgba(208, 0, 127, 0.18), rgba(0, 0, 0, 0.82) 70%);
    backdrop-filter: blur(7px) saturate(120%);
    -webkit-backdrop-filter: blur(7px) saturate(120%);
    animation: fade-in 0.45s both;
  }
  .popup.is-closing::backdrop { animation: fade-out 0.22s ease-in both; }

  /* turning brand-colour edge */
  .popup::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 4;
    border-radius: inherit;
    padding: 1.5px;
    pointer-events: none;
    background: conic-gradient(from var(--pa), transparent 0 55%, var(--cyan) 70%, var(--pink) 86%, var(--sun) 94%, transparent 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    animation: spin-edge 7s linear infinite;
  }

  /* ── visual: a camera viewfinder locking onto the face ── */
  .popup__visual {
    grid-area: visual;
    position: relative;
    isolation: isolate;
    container-type: size;
    min-height: 100%;
    overflow: hidden;
    background: #0b0b14;
  }
  .popup__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 61% 21%; /* = the face's position in the photo, so the focus ring below always sits on it */
    animation: drift 9s cubic-bezier(.2, .7, .2, 1) both;
  }
  .popup__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(10, 10, 20, 0.15) 0%, transparent 35%, rgba(10, 10, 20, 0.88) 100%);
  }
  .vf {
    position: absolute;
    z-index: 2;
    width: 34px;
    height: 34px;
    border: 0 solid #fff;
    opacity: 0;
    animation: lock 0.9s 0.35s cubic-bezier(.2, .9, .2, 1) both;
  }
  .vf--tl { top: 22px; left: 22px; border-width: 3px 0 0 3px; border-top-left-radius: 8px; --from: -26px; }
  .vf--tr { top: 22px; right: 22px; border-width: 3px 3px 0 0; border-top-right-radius: 8px; }
  .vf--bl { bottom: 22px; left: 22px; border-width: 0 0 3px 3px; border-bottom-left-radius: 8px; }
  .vf--br { bottom: 22px; right: 22px; border-width: 0 3px 3px 0; border-bottom-right-radius: 8px; }
  .vf--tl { --dx: -26px; --dy: -26px; }
  .vf--tr { --dx: 26px; --dy: -26px; }
  .vf--bl { --dx: -26px; --dy: 26px; }
  .vf--br { --dx: 26px; --dy: 26px; }
  .focus {
    position: absolute;
    z-index: 2;
    left: 61%;
    top: 21%;
    width: clamp(46px, 20cqmin, 88px);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    border: 2px solid var(--sun);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25), 0 0 22px rgba(247, 231, 26, 0.45);
    opacity: 0;
    animation: focus-lock 1.15s 0.75s cubic-bezier(.3, 1.3, .4, 1) both, focus-settle 0.5s 1.9s ease both;
  }
  .who {
    position: absolute;
    z-index: 3;
    inset-inline: 52px;
    bottom: 44px;
    display: grid;
    gap: 2px;
    padding-inline-start: 14px;
    border-inline-start: 3px solid var(--pink);
    animation: rise 0.7s 1.1s cubic-bezier(.2, .8, .2, 1) both;
  }
  .who strong { font-size: 1.35rem; line-height: 1.2; color: #fff; }
  .who span { font-size: 0.95rem; color: #e6e6ee; }

  /* ── body ── */
  .popup__body {
    grid-area: body;
    align-self: center;
    padding: clamp(30px, 4vw, 48px) clamp(24px, 3.6vw, 44px);
  }
  .popup__body h2 {
    margin: 0 0 8px;
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: #fff;
    max-width: 11em;
    outline: none;
    animation: rise 0.6s 0.25s cubic-bezier(.2, .8, .2, 1) both;
  }
  .popup__sub {
    margin: 0 0 22px;
    color: #c4c4cc;
    font-size: 1.05rem;
    animation: rise 0.6s 0.33s cubic-bezier(.2, .8, .2, 1) both;
  }
  .popup__body :global(.lead-form) {
    grid-template-columns: 1fr 1fr;
    gap: 14px 12px;
    animation: rise 0.6s 0.42s cubic-bezier(.2, .8, .2, 1) both;
  }
  .popup__body :global(.lead-form .field) { min-width: 0; }
  .popup__body :global(.lead-form .field:has([name='message'])) { grid-column: 1 / -1; order: 3; }
  .popup__body :global(.lead-form textarea) { min-height: 84px; }
  .popup__body :global(.lead-form .btn),
  .popup__body :global(.lead-form .lead-form__status) { grid-column: 1 / -1; order: 4; }
  .popup__body :global(.lead-form .lead-form__status) { order: 5; }
  .popup__body :global(.lead-form .lead-form__captcha) { grid-column: 1 / -1; order: 4; }
  .popup__body :global(.lead-form label) { color: #e9e9ee; font-weight: 700; font-size: 0.9rem; }
  .popup__body :global(.lead-form input),
  .popup__body :global(.lead-form textarea) {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 14px;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
  }
  .popup__body :global(.lead-form input:focus),
  .popup__body :global(.lead-form textarea:focus) {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--cyan);
    box-shadow: 0 0 0 4px rgba(4, 168, 241, 0.22);
  }
  .popup__body :global(.lead-form .lead-form__status:empty) { height: 0; margin: -7px 0 0; }
  .popup__body :global(.lead-form .lead-form__status) { min-height: 0; }
  .popup__body :global(.lead-form .btn) {
    justify-self: stretch;
    min-height: 54px;
    font-size: 1.08rem;
    font-weight: 800;
    background: var(--pink);
    box-shadow: 0 10px 30px rgba(208, 0, 127, 0.45);
    position: relative;
    overflow: hidden;
  }
  .popup__body :global(.lead-form .btn::after) {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgba(255, 255, 255, 0.35) 50%, transparent 65%);
    transform: translateX(120%);
  }
  .popup__body :global(.lead-form .btn:hover) { box-shadow: 0 14px 38px rgba(208, 0, 127, 0.6); transform: translateY(-2px); }
  .popup__body :global(.lead-form .btn:hover::after) { transform: translateX(-120%); transition: transform 0.7s ease; }
  .popup__body :global(.lead-form .btn:disabled) { opacity: 0.7; cursor: progress; }
  .popup__wa {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    padding: 10px 4px;
    color: #e9e9ee;
    font-weight: 700;
    text-decoration: none;
    animation: rise 0.6s 0.5s cubic-bezier(.2, .8, .2, 1) both;
  }
  .popup__wa :global(svg) { color: #25d366; flex: none; }
  .popup__wa:hover span { text-decoration: underline; text-underline-offset: 4px; }

  .popup__close {
    position: absolute;
    z-index: 6;
    top: 14px;
    left: 14px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 50%;
    background: rgba(12, 12, 16, 0.55);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s, transform 0.35s cubic-bezier(.3, 1.4, .5, 1);
  }
  .popup__close:hover { background: var(--pink); border-color: var(--pink); transform: rotate(90deg); }

  @keyframes pop-in { from { opacity: 0; transform: translateY(34px) scale(0.95); } to { opacity: 1; transform: none; } }
  @keyframes pop-out { to { opacity: 0; transform: translateY(14px) scale(0.97); } }
  @keyframes fade-in { from { opacity: 0; } }
  @keyframes fade-out { to { opacity: 0; } }
  @keyframes spin-edge { to { --pa: 360deg; } }
  @keyframes drift { from { transform: scale(1.14); } to { transform: scale(1); } }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @keyframes lock {
    0% { opacity: 0; transform: translate(var(--dx), var(--dy)); }
    60% { opacity: 1; }
    100% { opacity: 1; transform: none; border-color: var(--cyan); }
  }
  @keyframes focus-lock {
    0% { opacity: 0; transform: scale(2.6); filter: blur(6px); }
    55% { opacity: 1; transform: scale(0.88); filter: blur(0); }
    100% { opacity: 1; transform: scale(1); }
  }
  @keyframes focus-settle { to { border-color: var(--cyan); box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25), 0 0 22px rgba(4, 168, 241, 0.55); } }

  @media (max-width: 760px) {
    .popup[open] {
      grid-template-columns: 1fr;
      grid-template-areas: 'visual' 'body';
    }
    .popup__visual { min-height: 0; height: 168px; }
    .popup__img { object-position: 61% 21%; }
    .vf { width: 24px; height: 24px; }
    .vf--tl, .vf--tr { top: 14px; }
    .vf--bl, .vf--br { bottom: 14px; }
    .vf--tl, .vf--bl { left: 14px; }
    .vf--tr, .vf--br { right: 14px; }
    .who { bottom: 20px; inset-inline: 50px 16px; }
    .who strong { font-size: 1.1rem; }
    .who span { font-size: 0.85rem; }
    .popup__body { padding: 22px 20px 20px; }
    .popup__body h2 { font-size: 1.7rem; max-width: none; }
    .popup__sub { margin-bottom: 16px; }
    .popup__body :global(.lead-form) { grid-template-columns: 1fr; }
    .popup__body :global(.lead-form .field:has([name='message'])) { order: 0; }
    .popup__body :global(.lead-form textarea) { min-height: 72px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .popup[open], .popup[open]::backdrop, .popup__img, .vf, .focus, .who, .popup__body h2, .popup__sub,
    .popup__body :global(.lead-form), .popup__wa { animation: none !important; opacity: 1; transform: none; }
    .popup::before { animation: none; }
    .vf { border-color: var(--cyan); }
    .focus { border-color: var(--cyan); }
  }
</style>
