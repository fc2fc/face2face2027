---
interface Field {
  type: string;
  name: string;
  label: string;
  required?: boolean;
  rows?: number;
}
interface Props {
  fields: Field[];
  submitLabel: string;
  formName: string;
}
const { fields, submitLabel, formName } = Astro.props;
const AUTOCOMPLETE: Record<string, string> = { text: 'name', tel: 'tel', email: 'email' };
// Web3Forms. PUBLIC_FORM_ENDPOINT (Vercel env / .env) holds the Web3Forms Access Key. Web3Forms keys are
// designed to be public (they only allow sending to the mailbox registered with the key).
const ENDPOINT = 'https://api.web3forms.com/submit';
const accessKey = String(import.meta.env.PUBLIC_FORM_ENDPOINT ?? '').trim();
// Spam protection: Web3Forms' free hCaptcha integration. Web3Forms verifies the token on its own server
// (enable "hCaptcha" for this access key in the Web3Forms dashboard), so a bot that posts straight to the
// API without solving it is rejected. This is the public sitekey Web3Forms documents for the free plan.
const HCAPTCHA_SITEKEY = '50b2fe65-b00b-4b9e-ad62-3ba471098be2';
---

<form class="lead-form" method="post" action={ENDPOINT} data-endpoint={ENDPOINT} data-has-key={accessKey ? 'true' : 'false'} data-form-name={formName} novalidate>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="ליד חדש מהאתר Face2Face" />
  <input type="hidden" name="from_name" value="אתר Face2Face" />
  <input type="hidden" name="form" value={formName} />
  {
    fields.map((f) => {
      const id = `${formName}-${f.name}`;
      return (
        <div class="field">
          <label for={id}>
            {f.label}
            {f.required && <span aria-hidden="true"> *</span>}
          </label>
          {f.type === 'textarea' ? (
            <textarea id={id} name={f.name} rows={f.rows ?? 4} required={f.required} />
          ) : (
            <input
              id={id}
              name={f.name}
              type={f.type}
              required={f.required}
              autocomplete={AUTOCOMPLETE[f.type]}
              inputmode={f.type === 'tel' ? 'tel' : f.type === 'email' ? 'email' : undefined}
              dir={f.type === 'tel' || f.type === 'email' ? 'ltr' : undefined}
            />
          )}
        </div>
      );
    })
  }
  <!-- Web3Forms honeypot: bots tick it, people never see it -->
  <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" style="display:none" />

  <!-- hCaptcha widget is rendered here when the visitor starts filling the form (not on page load) -->
  <div class="lead-form__captcha" data-sitekey={HCAPTCHA_SITEKEY}></div>

  <button class="btn" type="submit">{submitLabel}</button>
  <p class="lead-form__status" role="status" aria-live="polite"></p>
</form>

<script>
  type HC = {
    render: (el: HTMLElement, opts: Record<string, unknown>) => string;
    getResponse: (id?: string) => string;
    reset: (id?: string) => void;
  };
  const w = window as any;
  const forms = Array.from(document.querySelectorAll<HTMLFormElement>('form.lead-form'));
  const widgetIds = new Map<HTMLFormElement, string>();

  // Load hCaptcha only once someone actually interacts with a form: no third-party request and no
  // extra JS for visitors who never fill it in, and nothing competes with the Hero image for bandwidth.
  let loading: Promise<HC> | null = null;
  function loadCaptcha(): Promise<HC> {
    if (loading) return loading;
    loading = new Promise<HC>((resolve, reject) => {
      w.f2fHcaptchaReady = () => resolve(w.hcaptcha as HC);
      const s = document.createElement('script');
      s.src = 'https://js.hcaptcha.com/1/api.js?render=explicit&onload=f2fHcaptchaReady&hl=he&recaptchacompat=off';
      s.async = true;
      s.onerror = () => { loading = null; reject(new Error('hcaptcha load failed')); };
      document.head.appendChild(s);
    });
    return loading;
  }

  async function ensureWidget(form: HTMLFormElement): Promise<string | null> {
    if (widgetIds.has(form)) return widgetIds.get(form)!;
    const box = form.querySelector<HTMLElement>('.lead-form__captcha');
    if (!box) return null;
    try {
      const hc = await loadCaptcha();
      if (widgetIds.has(form)) return widgetIds.get(form)!;
      const id = hc.render(box, { sitekey: box.dataset.sitekey, theme: 'dark', hl: 'he' });
      widgetIds.set(form, id);
      return id;
    } catch {
      return null;
    }
  }

  forms.forEach((form) => {
    const status = form.querySelector<HTMLElement>('.lead-form__status')!;
    const warm = () => { ensureWidget(form); };
    form.addEventListener('focusin', warm, { once: true });
    form.addEventListener('pointerdown', warm, { once: true });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      if (form.dataset.hasKey !== 'true') {
        status.textContent = 'הטופס אינו זמין כרגע. אפשר לפנות ב-WhatsApp או במייל face2faceprint@gmail.com';
        status.dataset.state = 'error';
        return;
      }

      const widgetId = await ensureWidget(form);
      const hc: HC | undefined = w.hcaptcha;
      if (widgetId !== null && hc && !hc.getResponse(widgetId)) {
        status.textContent = 'רגע לפני השליחה: סמנו את תיבת האימות שמעל הכפתור.';
        status.dataset.state = 'error';
        return;
      }

      const btn = form.querySelector('button')!;
      btn.disabled = true;
      status.textContent = 'שולח…';
      status.dataset.state = '';
      try {
        const res = await fetch(form.dataset.endpoint!, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || data.success === false) throw new Error(data.message || String(res.status));
        form.reset();
        status.textContent = 'הפרטים נשלחו בהצלחה, נחזור אליך בהקדם!';
        status.dataset.state = 'ok';
        w.f2fTrack?.('generate_lead', { form_name: form.dataset.formName }, 'Lead');
      } catch {
        status.textContent = 'השליחה נכשלה. נסו שוב או פנו ב-WhatsApp.';
        status.dataset.state = 'error';
      } finally {
        // A captcha token is single-use, so always start fresh for the next attempt
        if (widgetId !== null && hc) { try { hc.reset(widgetId); } catch {} }
        btn.disabled = false;
      }
    });
  });
</script>

<style>
  .lead-form {
    display: grid;
    gap: 14px;
  }
  .lead-form__captcha:empty {
    display: none;
  }
  .lead-form__captcha {
    grid-column: 1 / -1;
    min-height: 78px; /* hCaptcha checkbox height, so the button doesn't jump when it appears */
    max-width: 100%;
    overflow: hidden;
  }
  .field {
    display: grid;
    gap: 4px;
  }
  label {
    font-weight: 600;
    font-size: 0.95rem;
  }
  input,
  textarea {
    font: inherit;
    font-size: 16px; /* prevents iOS zoom on focus */
    width: 100%;
    padding: 0.75em 0.9em;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface-2);
    color: var(--ink);
    min-height: 48px;
    -webkit-appearance: none;
    appearance: none;
    touch-action: manipulation;
  }
  textarea {
    min-height: 100px;
    resize: vertical;
  }
  input:focus,
  textarea:focus {
    border-color: var(--brand);
    outline: none;
    box-shadow: 0 0 0 3px rgba(208,0,127, 0.15);
  }
  [dir='ltr'] {
    text-align: right;
  }
  .btn {
    justify-self: start;
  }
  @media (max-width: 480px) {
    .btn {
      justify-self: stretch;
      width: 100%;
      min-height: 52px;
      font-size: 1rem;
    }
  }
  .lead-form__status {
    margin: 0;
    min-height: 1.5em;
    font-weight: 600;
  }
  .lead-form__status[data-state='ok'] {
    color: #5be38a;
  }
  .lead-form__status[data-state='error'] {
    color: #ff8095;
  }
</style>
