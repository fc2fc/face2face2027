---
/**
 * One icon family across the whole site (Phosphor, "regular" weight, 256-grid, fill=currentColor).
 * Decorative by default (aria-hidden); pass `label` when the icon carries meaning on its own.
 */
interface Props {
  name: string;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 24, label, class: cls } = Astro.props;
const files = import.meta.glob('../assets/icons/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const raw = files[`../assets/icons/${name}.svg`];
if (!raw) throw new Error(`Icon "${name}" not found in src/assets/icons`);
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---

<svg
  class:list={['icon', cls]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={inner}
/>

<style is:global>
  svg.icon { flex: none; display: inline-block; vertical-align: middle; }
</style>
