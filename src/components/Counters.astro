---
import { Image } from 'astro:assets';
import { site } from '../lib/content';
import Icon from './Icon.astro';
import logo from '../assets/media/brand/logo-light@2x.webp';

interface Props {
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;

// שלוף מהנתונים + fallback מלא
const rawCounters = site.counters as { value: string; label: string }[] || [];

// מונים עם fallback ל-hardcoded אם חסרים
const counters = rawCounters.length > 0 ? rawCounters : [
  { value: '4950+', label: 'עבודות מוצלחות' },
  { value: '16+', label: 'שנות ניסיון' },
  { value: '100%', label: 'שביעות רצון' },
];

// אם יש רק מונה אחד, הרחב
const displayCounters = counters.length === 1
  ? [
      counters[0],
      { value: '16+', label: 'שנות ניסיון' },
      { value: '100%', label: 'שביעות רצון' },
    ]
  : counters;

const icons = ['camera', 'medal', 'smiley', 'video-camera'];

function parseCounter(val: string) {
  const num = parseInt(val.replace(/\D/g, ''), 10) || 0;
  const suffix = val.replace(/[\d,]/g, '').trim();
  return { num, suffix };
}
---

<section class="section section--dark" id="numbers">
  <div class="container">
    <Heading class="section-title section-title--logo"><Image class="title-logo" src={logo} alt="Face2Face" width={230} densities={[1, 2]} loading="lazy" /> <span>במספרים</span></Heading>
    <ul class="counters">
      {displayCounters.map((c, i) => {
        const { num, suffix } = parseCounter(c.value);
        return (
          <li class="counter">
            <span class="counter__icon" aria-hidden="true"><Icon name={icons[i] ?? icons[2]} size={30} /></span>
            <strong class="counter__val" data-target={num} data-suffix={suffix}>0</strong>
            <span class="counter__label">{c.label}</span>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<script>
  function startCounter(el: Element) {
    const target = parseInt((el as HTMLElement).dataset.target || '0', 10);
    const suffix = (el as HTMLElement).dataset.suffix || '';
    const dur = 2000;
    const start = performance.now();
    function tick(now: number) {
      const p = Math.min((now - start) / dur, 1);
      const ease = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.round(ease * target).toLocaleString('he-IL') + suffix;
      if (p < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      startCounter(e.target);
      obs.unobserve(e.target);
    });
  }, { threshold: 0.3 });

  document.querySelectorAll('.counter__val').forEach(el => obs.observe(el));
</script>

<style>
  .counters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 24px;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }
  .counter {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 32px 24px;
    text-align: center;
    transition: background 0.3s, transform 0.3s;
  }
  .counter:hover { background: rgba(255,255,255,0.07); transform: translateY(-4px); }
  .counter__icon { display: grid; place-items: center; width: 52px; height: 52px; margin: 0 auto 14px; border-radius: 14px; background: rgba(208,0,127,0.14); color: var(--brand); }
  .counter__val {
    display: block;
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    font-weight: 900;
    color: #fff;
    line-height: 1;
  }
  .counter__label { display: block; margin-top: 8px; color: rgba(255,255,255,0.65); font-size: 0.9rem; font-weight: 500; }
  @media (max-width: 640px) {
    /* stays side-by-side (3-up) instead of stacking to full-width rows */
    .counters {
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }
    .counter {
      padding: 14px 6px;
      border-radius: 12px;
    }
    .counter__icon { width: 34px; height: 34px; border-radius: 10px; margin: 0 auto 6px; }
    .counter__icon :global(svg) { width: 16px; height: 16px; }
    .counter__val { font-size: clamp(1.15rem, 5.5vw, 1.6rem); }
    .counter__label { font-size: 0.64rem; line-height: 1.25; margin-top: 4px; }
  }
  .counter:nth-child(2) .counter__icon { background: rgba(4,168,241,0.16); color: var(--blue); }
  .counter:nth-child(2) .counter__val { color: var(--blue); }
  .counter:nth-child(3) .counter__icon { background: rgba(247,231,26,0.16); color: var(--yellow); }
  .counter:nth-child(3) .counter__val { color: var(--yellow); }
  .section-title--logo { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 0; }
  .section-title--logo span { display: block; line-height: 1; margin-top: var(--logo-gap, -0.2em); }
  .title-logo { width: clamp(150px, 26vw, 230px); aspect-ratio: 800 / 187; display: block; margin-inline: auto; }
</style>
