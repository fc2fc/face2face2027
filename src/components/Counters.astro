---
import { site } from '../lib/content';

interface Props {
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const counters = site.counters as { value: string; label: string }[];

const icons = ['📸', '🏆', '⭐', '🎬'];
---

<section class="section section--dark" id="numbers">
  <div class="container">
    <Heading class="section-title">Face2Face במספרים</Heading>
    <ul class="counters">
      {
        counters.map((c, i) => (
          <li class="counter">
            <span class="counter__icon" aria-hidden="true">{icons[i] ?? '✨'}</span>
            <strong class="counter__val" data-target={c.value.replace(/\D/g, '')} data-suffix={c.value.replace(/\d/g, '')}>0</strong>
            <span class="counter__label">{c.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement;
      const target = parseInt(el.dataset.target || '0');
      const suffix = el.dataset.suffix || '';
      const dur = 1800;
      const start = performance.now();
      const tick = (now: number) => {
        const p = Math.min((now - start) / dur, 1);
        const ease = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(ease * target).toLocaleString('he-IL') + suffix;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      obs.unobserve(el);
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.counter__val').forEach(el => obs.observe(el));
</script>

<style>
  .section--dark .section-title::after {
    background: var(--brand);
  }
  .counters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 24px;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }
  .counter {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 32px 24px;
    text-align: center;
    transition: background 0.3s, transform 0.3s;
  }
  .counter:hover {
    background: rgba(255,255,255,0.07);
    transform: translateY(-4px);
  }
  .counter__icon {
    display: block;
    font-size: 2rem;
    margin-bottom: 12px;
  }
  .counter__val {
    display: block;
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    font-weight: 900;
    color: var(--brand);
    line-height: 1;
  }
  .counter__label {
    display: block;
    margin-top: 8px;
    color: rgba(255,255,255,0.65);
    font-size: 0.9rem;
    font-weight: 500;
  }
</style>
