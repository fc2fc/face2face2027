---
// Same JSON-LD that was injected through Site123 "Custom Code", with image URLs moved to the new media paths.
const SITE = 'https://www.fc2fc.co.il';
const sameAs = [
  'https://www.facebook.com/Face2FaceNM',
  'https://www.instagram.com/face2face.il/',
  'https://www.youtube.com/channel/UCQiw4Yb63IUjjAmjmKkAG0Q',
];
const image = `${SITE}/assets/media/og/6883cf3ad224c.jpg`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE}/#naga-malasa`,
      name: 'נגה מלסה',
      alternateName: ['Naga Malasa'],
      jobTitle: 'צלם ומעצב גרפי',
      description:
        'נגה מלסה הוא צלם ומעצב גרפי, פעיל מאז 2010 ומייסד סטודיו Face2Face (2016), המתמחה בפורטרטים עסקיים, צילום תדמית, תיעוד כנסים ואירועים, הפקת סרטוני תדמית ועיצוב גרפי. (Naga Malasa)',
      image,
      url: `${SITE}/`,
      email: 'face2faceprint@gmail.com',
      telephone: '+972-52-813-3633',
      worksFor: { '@id': `${SITE}/#business` },
      knowsAbout: ['צילום פורטרט עסקי', 'צילום תדמית', 'צילום אירועים וכנסים', 'סרטוני תדמית', 'עיצוב גרפי', 'מיתוג'],
      nationality: { '@type': 'Country', name: 'ישראל' },
      sameAs,
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE}/#business`,
      name: 'Face2Face',
      alternateName: ['נגה מלסה – Face2Face', 'Face2Face – נגה מלסה', 'Face2Face – Naga Malasa', 'פייס טו פייס'],
      description: 'סטודיו לצילום סטילס, צילום וידאו, עריכה, עיצוב גרפי ומיתוג לעסקים, לאנשי ציבור ולפרטיים, בניהולו של נגה מלסה.',
      url: `${SITE}/`,
      // Square logo (Google shows it next to results / in the business panel); was a 1200x630 banner.
      logo: { '@type': 'ImageObject', url: `${SITE}/logo-square.png`, width: 600, height: 600 },
      image,
      telephone: '+972-52-813-3633',
      email: 'face2faceprint@gmail.com',
      foundingDate: '2016',
      founder: { '@id': `${SITE}/#naga-malasa` },
      address: { '@type': 'PostalAddress', addressLocality: 'קרית גת', addressRegion: 'מחוז הדרום', addressCountry: 'IL' },
      areaServed: [{ '@type': 'City', name: 'קרית גת' }, { '@type': 'Country', name: 'ישראל' }],
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'],
          opens: '08:00',
          closes: '17:00',
        },
        { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '08:00', closes: '12:00' },
      ],
      sameAs,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: `${SITE}/`,
      name: 'נגה מלסה – Face2Face',
      publisher: { '@id': `${SITE}/#business` },
      inLanguage: 'he',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${SITE}/work/{search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'ImageObject',
      '@id': `${SITE}/#main-image`,
      url: image,
      contentUrl: image,
      name: 'נגה מלסה – צלם ומעצב גרפי, Face2Face',
      description: 'תמונת פרופיל של נגה מלסה, מייסד סטודיו Face2Face לצילום ועיצוב גרפי',
      author: { '@id': `${SITE}/#naga-malasa` },
      copyrightHolder: { '@id': `${SITE}/#business` },
      license: 'https://creativecommons.org/licenses/by-nc-nd/4.0/',
      inLanguage: 'he',
    },
    {
      '@type': 'WebPage',
      '@id': `${SITE}/#webpage`,
      url: `${SITE}/`,
      name: 'נגה מלסה – Face2Face | צלם ומעצב גרפי',
      description: 'סטודיו לצילום סטילס, וידאו ועיצוב גרפי בניהולו של נגה מלסה. פורטרט עסקי, תדמית, כנסים ואירועים.',
      inLanguage: 'he',
      isPartOf: { '@id': `${SITE}/#website` },
      about: { '@id': `${SITE}/#business` },
      primaryImageOfPage: { '@id': `${SITE}/#main-image` },
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
