---
import { site, size, toParagraphs } from '../lib/content';

interface Props {
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const about = site.about;
const paragraphs = toParagraphs(about.paragraphs);
---

<section class="section" id="about">
  <div class="container about">
    <div class="about__visual">
      <span class="ring ring--a" aria-hidden="true"></span>
      <span class="ring ring--b" aria-hidden="true"></span>
      <div class="arch">
        <img src={about.image} alt={about.image_alt} {...size(about.image)} loading="lazy" />
      </div>
      <div class="chip chip--exp" aria-hidden="true">
        <strong>16+</strong>
        <span>שנות ניסיון</span>
      </div>
      <div class="chip chip--proj" aria-hidden="true">
        <strong>4,950+</strong>
        <span>פרויקטים</span>
      </div>
      <ul class="tags" aria-label="תחומי התמחות">
        <li>צילום סטילס</li>
        <li>הפקת וידאו</li>
        <li>מיתוג ועיצוב</li>
      </ul>
    </div>
    <div class="about__text">
      <Heading class="section-title about__title">אודות</Heading>
      {paragraphs.map((p, i) => (i === 0 ? <p class="about__hello">{p}</p> : <p>{p}</p>))}
      <div class="about__actions">
        <a class="btn" href="/צרו-קשר">בואו נדבר</a>
        <a class="btn btn--ghost" href="/עבודות">לעבודות שלנו</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(280px, 0.85fr) 1.15fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }
  .about__visual {
    position: relative;
    max-width: 440px;
    width: 100%;
    margin-inline: auto;
    padding: 18px;
  }
  .arch {
    position: relative;
    z-index: 1;
    border-radius: 999px 999px 28px 28px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: var(--surface);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6);
  }
  .arch img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }
  .ring {
    position: absolute;
    border-radius: 999px 999px 28px 28px;
    pointer-events: none;
  }
  .ring--a {
    inset: 0 0 0 0;
    border: 2px solid var(--brand);
    transform: translate(14px, 14px);
  }
  .ring--b {
    inset: 0;
    border: 2px solid var(--blue);
    transform: translate(-12px, -8px) scale(1.02);
    opacity: 0.55;
  }
  .chip {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 18px;
    border-radius: 16px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.5);
    animation: float 6s ease-in-out infinite;
  }
  .chip strong { font-size: 1.7rem; font-weight: 900; line-height: 1; }
  .chip span { font-size: 0.85rem; }
  .chip--exp { top: 14%; inset-inline-end: -4px; background: var(--brand); color: #fff; }
  .chip--proj {
    bottom: 16%;
    inset-inline-start: -8px;
    background: rgba(24, 24, 24, 0.9);
    border: 1px solid var(--line);
    color: #fff;
    animation-delay: -3s;
  }
  .chip--proj span { color: var(--muted); }
  .tags {
    position: absolute;
    z-index: 2;
    bottom: -6px;
    inset-inline: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tags li {
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 700;
    color: #fff;
    background: #0e0e0e;
    border: 1px solid var(--line);
    padding: 6px 14px;
    border-radius: 100px;
  }
  .tags li:nth-child(1) { border-color: var(--brand); }
  .tags li:nth-child(2) { border-color: var(--blue); }
  .tags li:nth-child(3) { border-color: var(--yellow); }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-9px); }
  }
  @media (prefers-reduced-motion: reduce) { .chip { animation: none; } }

  .about__title { text-align: start; }
  .about__title::after { margin-inline: 0; }
  .about__hello {
    font-size: 1.4rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.4;
  }
  p { margin: 0 0 1em; color: var(--muted); }
  .about__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 0.5rem; }
  @media (max-width: 760px) {
    .about { grid-template-columns: 1fr; gap: 44px; }
    .about__visual { max-width: 360px; }
  }
  @media (max-width: 480px) {
    .about__actions { flex-direction: column; gap: 10px; }
    .about__actions .btn { width: 100%; justify-content: center; min-height: 52px; }
    .chip--exp { inset-inline-end: -2px; }
    .chip--proj { inset-inline-start: -2px; }
  }
</style>
