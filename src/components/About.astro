---
import { Picture } from 'astro:assets';
import { site, asset, toParagraphs } from '../lib/content';

interface Props {
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const about = site.about;
const paragraphs = toParagraphs(about.paragraphs);
---

<section class="section" id="about" data-about>
  <div class="container about">
    <div class="about__visual">
      <span class="ring ring--a" aria-hidden="true" style="--sp:-26px"></span>
      <span class="ring ring--b" aria-hidden="true" style="--sp:34px"></span>
      <div class="arch" style="--sp:12px">
        <Picture
          src={asset(about.image)}
          alt={about.image_alt}
          widths={[360, 540, 800]}
          sizes="(max-width: 760px) 90vw, 420px"
          formats={['avif']}
          fallbackFormat="webp"
          loading={headingLevel === 'h1' ? 'eager' : 'lazy'}
          fetchpriority={headingLevel === 'h1' ? 'high' : undefined}
        />
      </div>
      <div class="chip chip--exp" aria-hidden="true" style="--sp:-70px">
        <strong>16+</strong>
        <span>שנות ניסיון</span>
      </div>
      <div class="chip chip--proj" aria-hidden="true" style="--sp:60px">
        <strong>4,950+</strong>
        <span>פרויקטים</span>
      </div>
      <ul class="tags" aria-label="תחומי התמחות" style="--sp:-34px">
        <li>צילום סטילס</li>
        <li>הפקת וידאו</li>
        <li>מיתוג ועיצוב</li>
      </ul>
    </div>
    <div class="about__text">
      <Heading class="section-title about__title">אודות</Heading>
      {paragraphs.map((p, i) => <p class:list={['about__p', i === 0 && 'about__hello']} data-reveal>{p}</p>)}
      <div class="about__actions" data-cta>
        <a class="btn" href="/צרו-קשר">בואו נדבר</a>
        <a class="btn btn--ghost" href="/עבודות">לעבודות שלנו</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(280px, 0.85fr) 1.15fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }
  .about__visual {
    position: sticky;
    top: 96px;
    align-self: start;
    max-width: 440px;
    width: 100%;
    margin-inline: auto;
    padding: 18px;
  }
  .arch {
    position: relative;
    z-index: 1;
    border-radius: 999px 999px 28px 28px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: var(--surface);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6);
  }
  .arch img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }
  .ring {
    position: absolute;
    border-radius: 999px 999px 28px 28px;
    pointer-events: none;
  }
  .ring--a {
    inset: 0 0 0 0;
    border: 2px solid var(--brand);
    transform: translate(14px, 14px);
  }
  .ring--b {
    inset: 0;
    border: 2px solid var(--blue);
    transform: translate(-12px, -8px) scale(1.02);
    opacity: 0.55;
  }
  .chip {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 18px;
    border-radius: 16px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.5);
    animation: float 6s ease-in-out infinite;
  }
  .chip strong { font-size: 1.7rem; font-weight: 900; line-height: 1; }
  .chip span { font-size: 0.85rem; }
  .chip--exp { top: 14%; inset-inline-end: -4px; background: var(--brand); color: #fff; }
  .chip--proj {
    bottom: 16%;
    inset-inline-start: -8px;
    background: rgba(24, 24, 24, 0.9);
    border: 1px solid var(--line);
    color: #fff;
    animation-delay: -3s;
  }
  .chip--proj span { color: var(--muted); }
  .tags {
    position: absolute;
    z-index: 2;
    bottom: -6px;
    inset-inline: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tags li {
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 700;
    color: #fff;
    background: #0e0e0e;
    border: 1px solid var(--line);
    padding: 6px 14px;
    border-radius: 100px;
  }
  .tags li:nth-child(1) { border-color: var(--brand); }
  .tags li:nth-child(2) { border-color: var(--blue); }
  .tags li:nth-child(3) { border-color: var(--yellow); }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-9px); }
  }
  @media (prefers-reduced-motion: reduce) { .chip { animation: none; } }

  /* Parallax: --p (-1..1) is set by script from the section's scroll position; each layer has its own speed (--sp) */
  .ring, .chip, .tags, .arch { translate: 0 calc(var(--p, 0) * var(--sp, 0px)); will-change: translate; }
  .arch :global(img) { transform: scale(1.08) translateY(calc(var(--p, 0) * -14px)); }
  .about__text { padding-block: 0 clamp(24px, 6vh, 64px); }
  @media (max-width: 480px) { .about__text { padding-block-end: 0; } }
  .about__title { text-align: start; }
  .about__title::after { margin-inline: 0; }
  .about__p {
    margin: 0 0 clamp(34px, 7.5vh, 76px);
    font-size: clamp(1.15rem, 1.55vw, 1.4rem);
    line-height: 1.65;
    max-width: 38em;
    color: rgba(255, 255, 255, 0.55); /* dim, still >= 4.5:1 on the dark background */
    transition: color 0.6s ease;
  }
  .about__p.is-active { color: #fff; }
  .about__hello { font-size: clamp(1.5rem, 2.3vw, 2rem); font-weight: 800; line-height: 1.3; }
  .about__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: clamp(8px, 2vh, 24px);
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.7s ease, transform 0.8s cubic-bezier(.2,.7,.2,1);
  }
  .about__actions.is-in { opacity: 1; transform: none; }
  .about__actions .btn { transition-delay: 0s; }
  .about__actions.is-in .btn:nth-child(2) { animation: cta-in 0.7s 0.15s both cubic-bezier(.2,.7,.2,1); }
  @keyframes cta-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .about__p { color: #fff; transition: none; }
    .about__actions { opacity: 1; transform: none; transition: none; }
    .ring, .chip, .tags, .arch { translate: none; }
    .arch :global(img) { transform: none; }
    .about__actions.is-in .btn:nth-child(2) { animation: none; }
  }
  @media (max-width: 760px) {
    .about { grid-template-columns: 1fr; gap: 44px; }
    .about__visual { max-width: 360px; position: relative; top: 0; }
    .about__p { margin-bottom: 28px; line-height: 1.6; }
  }
  @media (max-width: 480px) {
    .about__actions { flex-direction: column; gap: 10px; }
    .about__actions .btn { width: 100%; justify-content: center; min-height: 52px; }
    .chip--exp { inset-inline-end: -2px; }
    .chip--proj { inset-inline-start: -2px; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-about]');
  if (root) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const paras = [...root.querySelectorAll<HTMLElement>('[data-reveal]')];
    const cta = root.querySelector<HTMLElement>('[data-cta]');
    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = innerHeight;
      const r = root.getBoundingClientRect();
      if (r.bottom < -100 || r.top > vh + 100) return;
      // parallax progress: -1 (section entering) .. 1 (leaving)
      const p = Math.max(-1, Math.min(1, (r.top + r.height / 2 - vh / 2) / (r.height / 2 + vh / 2)));
      root.style.setProperty('--p', p.toFixed(3));
      if (reduce) return;
      // text reveal: the paragraph closest to the middle of the screen is lit
      let best: HTMLElement | null = null, bd = Infinity;
      for (const el of paras) {
        const b = el.getBoundingClientRect();
        const d = Math.abs(b.top + b.height / 2 - vh * 0.5);
        if (d < bd) { bd = d; best = el; }
      }
      // before the first / after the last paragraph reaches the middle, keep the nearest one lit only if on screen
      paras.forEach((el) => el.classList.toggle('is-active', el === best && bd < vh * 0.6));
      if (cta && cta.getBoundingClientRect().top < vh * 0.9) cta.classList.add('is-in');
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    if (reduce) cta?.classList.add('is-in');
    update();
  }
</script>
